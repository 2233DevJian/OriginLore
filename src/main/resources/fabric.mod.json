{
  "schemaVersion": 1,
  "id": "originlore",
  "version": "${version}",
  "name": "Origin Lore",
  "description": "服务端权威的物品来源与数据组件管理：按来源和变体为物品写入名称、Lore 与属性，原版客户端无需安装 / Server-authoritative item source and data component manager: writes names, lore and attributes per source and variant, with no client mod required.",
  "authors": ["2233DevJian"],
  "contact": {
    "homepage": "https://github.com/2233DevJian/OriginLore",
    "repo": "https://github.com/2233DevJian/OriginLore",
    "issues": "https://github.com/2233DevJian/OriginLore/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.originlore.Originlore"
    ],
    "client": [
      "com.originlore.client.OriginloreClient"
    ]
  },
  "mixins": [
    "originlore.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "1.21.1",
    "fabric-api": "*",
    "java": ">=21"
  }
}
