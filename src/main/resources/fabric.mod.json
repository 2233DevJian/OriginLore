{
  "schemaVersion": 1,
  "id": "originlore",
  "version": "${version}",
  "name": "Origin Lore",
  "description": "自定义物品堆叠组件信息，让物品从世界生成时就自带自定义属性",
  "authors": ["You"],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.originlore.Originlore"
    ],
    "client": [
      "com.originlore.client.OriginloreClient"
    ]
  },
  "mixins": [
    "originlore.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "1.21.1",
    "fabric-api": "*",
    "java": ">=21"
  }
}
