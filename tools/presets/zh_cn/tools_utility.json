              "itemName": "旅者生火石",
              "loreJson": [
                {
                  "text": "铁片坚固耐磨，燧石棱角清晰，每一次利落的刮擦都能爆发出成串明亮的火星，迅速点燃营地篝火。",
                  "color": "white",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                64,
                64
              ]
            }
          },
