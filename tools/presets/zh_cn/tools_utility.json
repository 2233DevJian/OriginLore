              "loreJson": [
                {
                  "text": "采用高纯度精钢并附以握持护柄，搭配无瑕黑燧石，一击之下火星如金屑雨落，在风雨之中亦能瞬间引燃烈火。",
                  "color": "blue",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                70,
                77
              ]
            }
          }
