  "minecraft:goat_horn": {
    "base": {
      "loreJson": [
        {
          "text": "从山羊撞过的地方捡来的角。吹起来的声音能传得很远。",
          "color": "yellow",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lava_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "一桶还在流动的岩浆。端着它的时候最好别摔跤。",
          "color": "red",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lead": {
    "base": {
      "loreJson": [
        {
          "text": "打好的绳圈，一头拴动物一头拴栅栏。也可以拴点别的。",
          "color": "green",
          "italic": true
        }
      ]
    }
  },
  "minecraft:map": {
    "base": {
