              "loreJson": [
                {
                  "text": "采用深山极韧紫竹与坚不可摧的蛛丝编就，重心完美平衡，不论惊涛骇浪中的凶猛巨怪还是远古宝匣皆能一杆起水。",
                  "color": "blue",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                70,
                77
              ]
            }
          }
