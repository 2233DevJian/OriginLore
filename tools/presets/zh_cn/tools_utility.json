  "minecraft:flint_and_steel": {
    "base": {
      "loreJson": [
        {
          "text": "弯铁打火片与锋利燧石的绝妙组合。双手轻快一击，迸射出的灼热火星便能瞬间引燃干燥的引火物，或点亮下界传送之门。",
          "color": "white",
          "italic": true
        }
      ]
    },
    "sources": [
      {
        "type": "CHEST_LOOT",
        "variants": [
          {
            "id": "damaged",
            "weight": 70,
            "qualityScore": 0.15,
            "rule": {
              "itemName": "锈钝打火石",
              "loreJson": [
                {
                  "text": "钢片边缘已被敲击得坑洼生锈，燧石亦磨圆变钝，需多费几次手劲才能艰难引出几颗微弱的火星。",
                  "color": "gray",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                19,
                29
              ]
            }
          },
          {
            "id": "standard",
            "weight": 25,
            "qualityScore": 0.5,
