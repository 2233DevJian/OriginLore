  "minecraft:goat_horn": {
    "base": {
      "loreJson": [
        {
          "text": "峭壁野山羊撞击岩壁脱落的粗壮螺旋角。深吸一口气用力吹响，苍茫雄浑的远古号角声便能穿透群山与风雪，回荡于天地之间。",
          "color": "yellow",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lava_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "一桶还在流动的岩浆。端着它的时候最好别摔跤。",
          "color": "red",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lead": {
    "base": {
      "loreJson": [
        {
          "text": "打好的绳圈，一头拴动物一头拴栅栏。也可以拴点别的。",
          "color": "green",
          "italic": true
        }
      ]
    }
  },
  "minecraft:map": {
    "base": {
      "loreJson": [
        {
          "text": "经由甘蔗浆压平烘干的空白羊皮纸图册。捧在手中随风展开，便会随着你的足迹自动勾勒出周遭山川河流的壮丽地形。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:milk_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "铁桶盛装的醇香新鲜牛奶，白如凝脂。仰头咕咚饮尽，不仅能温润肠胃，更能瞬间荡涤体内附着的一切毒素与异常状态。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:name_tag": {
    "base": {
      "loreJson": [
        {
          "text": "结实皮绳系着黄铜铭牌的手工名牌。在铁砧上铭刻下独一无二的名号，系于生灵之颈，便能与它结下跨越时光的永恒羁绊，使其永不消逝。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:powder_snow_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "铁桶盛装的极寒细碎细雪，松软如羽，冰冷刺骨。倾倒于地便会化为致命的陷阱雪堆，踏入其中的生物若无皮靴便会迅速陷入冰冻失温。",
          "color": "aqua",
          "italic": true
        }
      ]
    }
  },
  "minecraft:pufferfish_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "装满海水的铁桶，一条鼓着腮帮、满身尖刺的鲜活河豚在其中缓缓游弋，随时准备迁入自家的景观水族箱。",
          "color": "yellow",
          "italic": true
        }
      ]
    }
  },
  "minecraft:recovery_compass": {
    "base": {
      "loreJson": [
        {
          "text": "四枚回响碎片与普通罗盘熔合铸就的追忆指针。暗青色的磁针在幽光中微微颤动，永远执着地指向你最后一次不幸倒下的丧命之地。",
          "color": "blue",
          "italic": true
        }
      ]
    }
  },
  "minecraft:saddle": {
    "base": {
      "loreJson": [
        {
          "text": "熟牛皮与精铁马镫精心缝制的鞍具，皮面油润光滑，配有可调节的肚带，是驯服烈马、骆驼与坚韧大猪的必备之物。",
          "color": "blue",
          "italic": true
        }
      ]
    }
  },
  "minecraft:salmon_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "装满冰冷溪水的铁桶，一条活蹦乱跳的鲜红大马哈鱼在其中欢快游动，随时准备移入山庄水榭之中。",
          "color": "aqua",
          "italic": true
        }
      ]
    }
  },
  "minecraft:shears": {
    "base": {
      "loreJson": [
        {
          "text": "两片精铁以销钉铆合的锋利剪刀，开合轻巧，无论是完整采收绵羊毛皮、修剪树叶还是拆除蜘蛛丝网皆干净利落。",
          "color": "white",
          "italic": true
        }
      ]
    },
