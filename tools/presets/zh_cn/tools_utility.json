  "minecraft:spyglass": {
    "base": {
      "loreJson": [
        {
          "text": "紫水晶透镜与两枚延展红铜管精密组装的单筒望远镜。举目凝望，极目之处的群山、敌巢与幽暗要塞便会在眼前豁然显现。",
          "color": "green",
          "italic": true
        }
      ]
    }
  },
  "minecraft:tadpole_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "盛满清冽池水的铁桶，一只活泼游弋的小蝌蚪在其中摆动着尾巴，随时准备移入池塘生长为捕食黏液怪的青蛙。",
          "color": "green",
          "italic": true
        }
      ]
    }
  },
  "minecraft:tropical_fish_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "盛满清澈海水的铁桶，一条色彩艳丽的热带鱼在其中悠游摇曳，随时准备迁入自家庭院的水榭鱼池之中。",
          "color": "aqua",
          "italic": true
        }
      ]
    }
  },
  "minecraft:warped_fungus_on_a_stick": {
    "base": {
      "loreJson": [
        {
          "text": "钓竿末梢悬挂着新鲜诡异菌的奇妙驭兽竿。在下界无垠熔岩之海上，它是驾驭炽足兽平稳疾驰、如履平地的无上利器。",
          "color": "aqua",
          "italic": true
        }
      ]
    },
    "sources": [
      {
        "type": "CRAFTING",
        "variants": [
          {
            "id": "handmade",
            "weight": 85,
            "qualityScore": 0.3,
            "rule": {
              "itemName": "粗绑诡异菌竿",
              "loreJson": [
                {
                  "text": "营火旁用麻绳将诡异菌随手打结系在木竿上的应急骑行具，晃动时稍显松垮，但足以引诱炽足兽带你横渡熔岩。",
                  "color": "gray",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                60,
                80
              ]
            }
          },
          {
            "id": "standard",
            "weight": 13,
            "qualityScore": 0.5,
            "rule": {
              "itemName": "熔岩骑乘诱导竿",
              "loreJson": [
                {
                  "text": "钓线长短精准，菌菇稳稳悬于坐骑视线前方，无论熔岩波涛如何起伏颠簸，都能让炽足兽全速平稳飞驰。",
                  "color": "white",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                100,
                100
              ]
            }
          },
          {
            "id": "refined",
            "weight": 2,
            "qualityScore": 0.9,
            "rule": {
              "itemName": "驭火使徒精装诡异菌竿",
              "loreJson": [
                {
                  "text": "选用极韧紫竹与精编蛛丝编就，诱导端配重天衣无缝，哪怕在滔天熔岩火海中疾驰亦能随心所欲驭兽前行。",
                  "color": "blue",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                110,
                120
              ]
            }
          }
        ]
      }
    ]
  },
  "minecraft:water_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "铁桶盛装的清澈活水，甘冽清凉。倾倒于地便能化作奔涌的清泉，熄灭烈火、浇灌农田或化解高空坠落的致命冲击。",
          "color": "white",
          "italic": true
        }
      ]
    }
  }
}
