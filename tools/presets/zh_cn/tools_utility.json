{
  "minecraft:axolotl_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "铁桶清澈的水底卧着一只粉嫩的小蝾螈，外鳃在水中缓缓飘动，好奇地打量着外面的世界。",
          "color": "aqua",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brush": {
    "base": {
      "loreJson": [
        {
          "text": "铜箍固定马鬃与飞羽制成的考古软刷。轻轻拂去古老沙土，便能让沉睡千年的历史重见天日。",
          "color": "green",
          "italic": true
        }
      ]
    },
    "sources": [
      {
        "type": "CRAFTING",
        "variants": [
          {
            "id": "handmade",
            "weight": 85,
            "qualityScore": 0.3,
            "rule": {
              "itemName": "简制羽毛刷",
              "loreJson": [
                {
                  "text": "营火旁用铜丝将禽羽勉强捆扎在木棍上的应急毛刷，刷毛稍显杂乱，清扫时需格外收敛手劲。",
                  "color": "gray",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                38,
                51
              ]
            }
          },
          {
            "id": "standard",
            "weight": 13,
            "qualityScore": 0.5,
            "rule": {
              "itemName": "考工探古刷",
              "loreJson": [
                {
                  "text": "刷毛修剪得齐整柔韧，铜套紧密咬合木柄，能极其均匀地拂开可疑碎屑，深得学者喜爱。",
                  "color": "white",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                64,
                64
              ]
            }
          },
          {
            "id": "refined",
            "weight": 2,
            "qualityScore": 0.9,
            "rule": {
              "itemName": "宗师精制羊毫刷",
              "loreJson": [
                {
                  "text": "选用最顶级柔韧鬃毛配以精工打磨的铜柄，触感细腻如丝，哪怕最脆薄的古代陶片也能被安全唤醒。",
                  "color": "blue",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                70,
                77
              ]
            }
          }
        ]
      }
    ]
  },
  "minecraft:bucket": {
    "base": {
      "loreJson": [
        {
          "text": "熟铁薄板打磨铆接而成的结实铁桶，容积可观，能稳稳盛起深井泉水、滚烫岩浆乃至游动的小鱼。",
          "color": "green",
          "italic": true
        }
      ]
    }
  },
  "minecraft:carrot_on_a_stick": {
    "base": {
      "loreJson": [
        {
          "text": "钓竿末梢悬挂着鲜嫩胡萝卜的滑稽装置。猪群会不知疲倦地追逐眼前的美味，从而化身为忠诚的坐骑。",
          "color": "yellow",
          "italic": true
        }
      ]
    },
    "sources": [
      {
        "type": "CRAFTING",
        "variants": [
          {
            "id": "handmade",
            "weight": 85,
            "qualityScore": 0.3,
            "rule": {
              "itemName": "粗绑胡萝卜竿",
              "loreJson": [
                {
                  "text": "临时用麻绳将胡萝卜打结挂在钓竿上的简陋引兽具，晃动时稍显松垮，但足以把猪引向你想去的地方。",
                  "color": "gray",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                15,
                20
              ]
            }
          },
          {
            "id": "standard",
            "weight": 13,
            "qualityScore": 0.5,
            "rule": {
              "itemName": "训猪者引路竿",
              "loreJson": [
                {
                  "text": "钓线长短适中，胡萝卜牢牢固定在视线正前方，无论颠簸起伏都能稳稳保持在坐骑的最强诱惑距离。",
                  "color": "white",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                25,
                25
              ]
            }
          },
          {
            "id": "refined",
            "weight": 2,
            "qualityScore": 0.9,
            "rule": {
              "itemName": "骑士精装诱导竿",
              "loreJson": [
                {
                  "text": "选用极韧木杆与精编丝线，引诱端配重完美，哪怕全速飞驰也能随心所欲地驾驭坐骑的方向。",
                  "color": "blue",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                28,
                30
              ]
            }
          }
        ]
      }
    ]
  },
  "minecraft:clock": {
    "base": {
      "loreJson": [
        {
          "text": "黄金外壳里嵌着灵动红石摆件的精密计时仪。即使深陷漆黑无日的矿井底层，表盘上的日月中枢依然指示着主界的天色。",
          "color": "yellow",
          "italic": true
        }
      ]
    }
  },
  "minecraft:cod_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "装满清澈海水的铁桶，一条活蹦乱跳的银白鳕鱼在其中欢快游动，随时准备迁入新的景观鱼塘。",
          "color": "aqua",
          "italic": true
        }
      ]
    }
  },
  "minecraft:compass": {
    "base": {
      "loreJson": [
        {
          "text": "四块精铁包裹红石枢轴制成的古老罗盘。磁针在风暴与迷雾中始终恒定指向世界最初诞生的原点。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:filled_map": {
    "base": {
      "loreJson": [
        {
          "text": "羊皮纸上绘制精密的地理图册，羊肠小径、山峦轮廓与海岸水系历历在目。唯有勇敢前行，方能将未知的漆黑迷雾一寸寸点亮。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:fishing_rod": {
    "base": {
      "loreJson": [
        {
          "text": "柔韧竹木、坚韧蚕丝线与锋利弯钩精巧组合的长竿。抛钩入水，剩下的便是在水波涟漪与微风中静候大鱼咬钩的漫长耐心。",
          "color": "green",
          "italic": true
        }
      ]
    },
    "sources": [
      {
        "type": "CHEST_LOOT",
        "variants": [
          {
            "id": "damaged",
            "weight": 70,
            "qualityScore": 0.15,
            "rule": {
              "itemName": "开裂旧竹竿",
              "loreJson": [
                {
                  "text": "竿身受潮后多有细微裂纹，丝线起了毛边，但在熟练渔夫手中，依然能沉稳地将水底的战利品拖出水面。",
                  "color": "gray",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                19,
                29
              ]
            }
          },
          {
            "id": "standard",
            "weight": 25,
            "qualityScore": 0.5,
            "rule": {
              "itemName": "渔夫韧丝钓竿",
              "loreJson": [
                {
                  "text": "竿体弹性十足，浸油丝线顺滑无阻，甩竿出水时弧线优美，能灵敏感知水下每一次细微的试探与触碰。",
                  "color": "white",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                64,
                64
              ]
            }
          },
          {
            "id": "refined",
