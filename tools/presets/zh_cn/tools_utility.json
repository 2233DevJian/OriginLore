        }
      ]
    }
  },
  "minecraft:brush": {
    "base": {
      "loreJson": [
        {
          "text": "羽毛、铜锭和一根棍子。扫开可疑的沙土才知道底下埋着什么。",
          "color": "green",
          "italic": true
        }
      ]
