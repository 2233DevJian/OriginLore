{
  "minecraft:anvil": {
    "base": {
      "loreJson": [
        {
          "text": "沉重冷硬的铸铁砧台，历经无数次重锤敲击依然纹丝不动，是兵器重铸与铭文命名的圣地。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:armor_stand": {
    "base": {
      "loreJson": [
        {
          "text": "简朴的平滑石座与细木支架，忠实地承托着卸下的头盔与甲胄，静候主人再次披甲出征。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:barrel": {
    "base": {
      "loreJson": [
        {
          "text": "铁箍收紧的厚实橡木桶，侧边开启的设计便于在狭窄的地窖与货舱中层叠堆放。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:beacon": {
    "base": {
      "loreJson": [
        {
          "text": "封存在黑曜石与玻璃中的下界之星。架设于高纯度的贵金属基座上时，能向苍穹激射出穿透云霄的神圣光柱。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bell": {
    "base": {
      "loreJson": [
        {
          "text": "厚重黄铜铸就的村庄警钟，悬于广场或廊下。猛力敲击时，雄浑清脆的钟声足以穿透风雨，唤归田野里的村民。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:blast_furnace": {
    "base": {
      "loreJson": [
        {
          "text": "铸铁加固的重型冶炼高炉，炉膛能产生远超普通石炉的炽烈风暴，专为极速熔炼矿石与金属而造。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bookshelf": {
    "base": {
      "loreJson": [
        {
          "text": "填满厚重典籍的雕花木书架，散发着皮革与羊皮纸的墨香，能为附近的附魔台源源不断地汇聚奥术智慧。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:campfire": {
    "base": {
      "loreJson": [
        {
          "text": "粗木交错搭就的露营篝火，青烟袅袅升空。不仅能在寒夜中提供光明与温暖，更能慢火烤香四份生食。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:cartography_table": {
    "base": {
      "loreJson": [
        {
          "text": "刻有经纬方格与罗盘方位的专用制图台。展开羊皮纸，便能在这里誊抄、缩放并拼接出探索世界的宏伟图卷。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:cauldron": {
    "base": {
      "loreJson": [
        {
          "text": "铸铁熔打而成的深腹大锅，厚重耐磨，既能蓄接雨水、盛装积雪，亦能安稳盛放灼热翻滚的岩浆。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:chain": {
    "base": {
      "loreJson": [
        {
          "text": "熟铁环环相扣锻造而成的沉重铁链，坚韧拉力十足，用于悬吊华丽吊灯、吊桥或加固悬空工程。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:chest": {
    "base": {
      "loreJson": [
        {
          "text": "结实木板与铁锁扣拼合的储物箱，只要上方留有余地，便能稳妥封存二十七格行囊与珍宝。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:chipped_anvil": {
    "base": {
      "loreJson": [
        {
          "text": "台角已崩落一块的铸铁砧，虽然承受重击时会发出略显沉闷的震颤，但残存的台面仍可锻造数件兵器。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:chiseled_bookshelf": {
    "base": {
      "loreJson": [
        {
          "text": "雕刻着规整隔槽的珍本藏书架，六处空槽各有定位，能随手取放并展示旅途中最重要的手抄典籍。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:composter": {
    "base": {
      "loreJson": [
        {
          "text": "侧壁留缝的木制堆肥桶，将多余的落叶、谷物与农作残料投入其中慢慢发酵，便能沉淀出极为肥沃的骨粉肥料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:conduit": {
    "base": {
      "loreJson": [
        {
          "text": "鹦鹉螺壳包裹着海洋之心的水下古代核心。在海晶石框架的激活下，能赋予潜水者在深海中呼吸与夜视的神力。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:crafting_table": {
    "base": {
      "loreJson": [
        {
          "text": "台面刻有三乘三九宫方格的坚固木工台，摊开各类原料，便能凭借智慧与双手打造出改造世界的无尽造物。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:damaged_anvil": {
    "base": {
      "loreJson": [
        {
          "text": "铁台深处裂纹纵横，每一次落锤都伴着微颤与哀鸣。它已行至残年，随时可能在下一声巨响中化作碎铁。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:decorated_pot": {
    "base": {
      "loreJson": [
        {
          "text": "四块陶片拼合烧制出的宽腹陶罐，器身绘有远古的图腾与印记，既能盛装珍贵杂物，亦是厅堂中雅致的古董。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:enchanting_table": {
    "base": {
      "loreJson": [
        {
          "text": "黑曜石与钻石砌成的奥术台座，悬浮其上的古老魔典感知着周围书架的智慧，在青金石的催化下将凡器升华入圣。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:end_rod": {
    "base": {
      "loreJson": [
        {
          "text": "自末地要塞塔尖采下的纯白灯杆，散发着永不熄灭的柔和虚空光芒，纤细优雅，安放在狭长走廊中格外明亮。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ender_chest": {
    "base": {
      "loreJson": [
        {
          "text": "黑曜石与末影之眼浇铸的虚空宝箱。箱口溢出幽紫微光，开启时永远只连通属于你自己那片独一无二的虚空储藏。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:fletching_table": {
    "base": {
      "loreJson": [
        {
          "text": "台面刻有羽翎与箭头凹槽的专业制箭台。工匠在此削木校轴、剪羽配重，是村庄中专业制箭师赖以谋生的工作台。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:flower_pot": {
    "base": {
      "loreJson": [
        {
          "text": "红砖黏土烧就的小巧厚沿陶盆，色泽朴实温润，移栽入一株娇嫩的花草或菌菇，便能为木桌增添一抹自然的生趣。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:furnace": {
    "base": {
      "loreJson": [
        {
          "text": "八块坚硬圆石层叠砌筑的重型石炉。内膛积满黑灰，只要投入煤炭或木柴，便能昼夜不息地熔炼矿石、烹煮丰盛的食物。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glow_item_frame": {
    "base": {
      "loreJson": [
        {
          "text": "涂抹了发光墨汁的皮革展示框。即便悬挂在昏暗幽深的地下储藏室，也能让框中陈列的宝物散发出一圈清晰柔和的轮廓微光。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glowstone": {
    "base": {
      "loreJson": [
        {
          "text": "采自下界悬顶的璀璨荧光石块，通体由密实的金黄晶粒聚集而成，悬挂于天花板上能洒下如恒星般永不熄灭的炽热光辉。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:grindstone": {
    "base": {
      "loreJson": [
        {
          "text": "坚固木架上装配的圆形粗砂磨盘。轻轻转动摇柄，便能洗去旧兵刃上杂乱的附魔符文，或将两件残破工具拼修如新。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:item_frame": {
    "base": {
      "loreJson": [
        {
          "text": "细木条绷紧熟皮革底衬的展示方框，悬挂于墙面或木箱外侧，陈列一件样品便能一目了然地辨明内藏物资。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:jack_o_lantern": {
    "base": {
      "loreJson": [
        {
          "text": "雕空南瓜腔体内置入燃烧火把的滑稽灯笼，不仅在黑夜中投下温暖明亮的金黄火光，更以其咧嘴笑脸驱散荒野的孤寂。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:jukebox": {
    "base": {
      "loreJson": [
        {
          "text": "选用珍贵木料与钻石唱针精工组装的留声唱片机。投入黑胶唱片，清澈动人的古老旋律便会悠扬飘荡于整座大厅。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ladder": {
    "base": {
      "loreJson": [
        {
          "text": "短木档牢固嵌入两侧长杆的手工梯子，贴墙垂直固定，便能在最小的空间内开辟出通向矿坑深处或高塔云霄的登攀通道。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lantern": {
    "base": {
      "loreJson": [
        {
          "text": "精致铁框护着温暖烛火的坚固吊灯，风吹不熄，雨打不灭，悬于门廊或立于栅栏之上皆能洒下一片安心的暖光。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lectern": {
    "base": {
      "loreJson": [
        {
          "text": "斜木板托住书页，放在路口读写都不必弯腰。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lodestone": {
    "base": {
      "loreJson": [
        {
          "text": "灰石外面箍着金属边，指南针碰过就会认准这里。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:loom": {
    "base": {
      "loreJson": [
        {
          "text": "木框拉着整齐的经线，织旗面的图案比徒手省事。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ochre_froglight": {
    "base": {
      "loreJson": [
        {
          "text": "橙黄温润的赭黄蛙明灯，由青蛙吞食微小岩浆怪后凝结而成，散发着如暖阳般恒久而柔和的金色光华。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:painting": {
    "base": {
      "loreJson": [
        {
          "text": "细木条为框、各色羊毛精心编织的手工油画。挂于墙面，便能随机展现出一幅描摹天地奇观或古典人物的艺术画卷。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:pearlescent_froglight": {
    "base": {
      "loreJson": [
        {
          "text": "泛着淡紫珍珠光泽的珠光蛙明灯，由青蛙吞食熔岩怪后凝结而成，散发着如梦似幻、高贵而柔和的紫粉微光。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:respawn_anchor": {
    "base": {
      "loreJson": [
        {
          "text": "哭泣黑曜石与荧光石熔铸的灵魂锚台。注入四颗荧石充能，便能在灼热凶险的下界为亡魂锚定重生的时空坐标。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:scaffolding": {
    "base": {
      "loreJson": [
        {
          "text": "空心竹节与坚韧细线编扎的轻巧脚手架，搭建极其迅捷，攀爬自如，拆除底座便能让整座高空架台瞬间如骨牌般应声散落。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:sea_lantern": {
    "base": {
      "loreJson": [
        {
          "text": "海晶碎片与海晶砂粒熔铸而成的深海明灯，散发着如清冽海水般澄澈通透的碧蓝白光，在水下亦能长久照亮幽暗的海渊。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:shroomlight": {
    "base": {
      "loreJson": [
        {
          "text": "生长在下界巨型菌木顶端的肉质菌光体，散发着如夕阳熔金般温暖明亮的光芒，质地柔软，触手微温。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:smithing_table": {
    "base": {
      "loreJson": [
        {
          "text": "覆有厚重铁砧台面与工具挂架的专业锻造台，是工匠借助锻造模版升级下界合金装备与铭刻绝美盔甲纹饰的圣地。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:smoker": {
    "base": {
      "loreJson": [
        {
          "text": "粗木包边、内部砌有通风烟道的专用熏烤炉。炉温温和恒定，烹制生肉与鱼类的速度比普通石炉快上一倍。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:soul_campfire": {
    "base": {
      "loreJson": [
        {
          "text": "以灵魂土或灵魂沙为引点燃的幽蓝篝火，青焰幽幽跳动而不散微尘，散发着来自下界死域的冰冷光华，能让凶残的猪灵退避三舍。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:soul_lantern": {
    "base": {
      "loreJson": [
        {
          "text": "铸铁精框护着幽蓝灵魂之火的挂灯，冷光清冽，即便在狂风暴雨中依然幽幽长明，常用于标记通往幽冥秘境的安全渡口。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:soul_torch": {
    "base": {
      "loreJson": [
        {
          "text": "细木棒顶端裹挟灵魂余烬点燃的幽蓝火把，光芒清冷低沉，静静燃烧时散发着来自死界深处的幽邃威慑力。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:stonecutter": {
    "base": {
      "loreJson": [
        {
          "text": "坚固石座上装配有飞速旋转锋利铁圆锯的专业切石机。将原石投入其中，便能以极高物料利用率一键裁切出各类楼梯、台阶与精美石砖。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:torch": {
    "base": {
      "loreJson": [
        {
          "text": "细木棍顶端绑裹煤炭点燃的朴实火把，金黄的火光在夜风中永不熄灭，是驱散至暗阴影、阻止魔物滋生的永恒守护者。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:verdant_froglight": {
    "base": {
      "loreJson": [
        {
          "text": "散发着冷翠萤光的青绿蛙明灯，由冷水青蛙吞食微小岩浆怪后凝结而成，宛若将一片幽静清冽的森林月夜封存其中。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  }
}
