{
  "minecraft:blaze_powder": {
    "base": {
      "loreJson": [
        {
          "text": "烈焰人核心研磨出的炽红粉末，触碰时指尖发烫，是驱动炼药台沸腾与激发力量药水的狂暴源泉。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brewing_stand": {
    "base": {
      "loreJson": [
        {
          "text": "烈焰棒为芯、鹅卵石为座的炼药台。支出的三只铁夹托住药瓶，在烈焰粉的狂暴炙烤下将药材融汇成奇迹魔药。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dragon_breath": {
    "base": {
      "loreJson": [
        {
          "text": "玻璃瓶封存的末影龙吐息残雾，深紫色的氤氲在瓶壁翻滚不休，是熬制滞留型大范围药水的至高触媒。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:experience_bottle": {
    "base": {
      "loreJson": [
        {
          "text": "琉璃细颈瓶中封存的翠绿魔力辉光。用力掷碎在地，沉睡的经验能量便会如雨洒落，迅速滋养冒险者的灵魂与装备。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:fermented_spider_eye": {
    "base": {
      "loreJson": [
        {
          "text": "混入糖与棕色蘑菇密封发酵的剧毒蛛眼。黏稠的深紫汁液散发着刺鼻的酸腐气味，能彻底逆转药性，炼出致盲与衰竭的黑魔法药剂。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ghast_tear": {
    "base": {
      "loreJson": [
        {
          "text": "击败下界恶魂自高空坠落时凝结出的乳白水滴。触手冰凉坚硬，蕴含着不可思议的愈合奇能，是熬制极效再生魔药的圣物。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glass_bottle": {
    "base": {
      "loreJson": [
        {
          "text": "细致吹制的轻薄小琉璃瓶，瓶口规整，洗净后不仅能盛装清泉与浓稠蜂蜜，更是炼金术士盛放各类奇迹魔药的必备容器。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glistering_melon_slice": {
    "base": {
      "loreJson": [
        {
          "text": "纯金粒严密包裹的鲜红西瓜片，金光闪烁，虽已非凡人口中果腹的甜食，却是炼金台上酿造强效治疗魔药不可替代的至宝。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glowstone_dust": {
    "base": {
      "loreJson": [
        {
          "text": "荧光石研磨出的金黄微光细粉，触感细腻带电，不仅能重新拼合为荧石块，更是炼金术士用来极大强化药水效力的核心秘药。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gunpowder": {
    "base": {
      "loreJson": [
        {
          "text": "击败苦力怕或恶魂收集的灰黑干燥细粉，触火即爆，是配制飞天烟花、烈性TNT炸药与喷溅药水的危险源泉。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lingering_potion": {
    "base": {
      "loreJson": [
        {
          "text": "稠密药液在瓶里转得很慢，落地碎开后会留下一团药雾。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:magma_cream": {
    "base": {
      "loreJson": [
        {
          "text": "击败下界岩浆怪析出的赤热黏膏，握在掌中温热滑腻，是炼金术士熬制抗火药水、使凡躯无惧烈焰熔浆的核心圣材。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:nether_wart": {
    "base": {
      "loreJson": [
        {
          "text": "唯有在灵魂沙上才能吸饱阴寒生长的深红下界疣，表面泛着水泡般的褶皱，是熬制一切高阶奇迹魔药不可或缺的粗制基底。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ominous_bottle": {
    "base": {
      "loreJson": [
        {
          "text": "封存着不详厄运与恶兆能量的阴冷药瓶。拔开木塞饮尽，浓郁的灾厄诅咒便会缠绕周身，在步入村庄或试炼密室时引动残酷的袭击试炼。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:phantom_membrane": {
    "base": {
      "loreJson": [
        {
          "text": "击落夜空幻翼获得的轻薄皮膜。柔韧半透明，握在手中轻若无物，是修复破损鞘翅与熬制缓慢降落药水的神秘精粹。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:potion": {
    "base": {
      "loreJson": [
        {
          "text": "琉璃细颈瓶中封存的魔力药水，澄澈的药液流转着神秘的气泡与微芒，拔塞饮尽，便能瞬间激发奇迹般的超凡状态。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:pufferfish": {
    "base": {
      "loreJson": [
        {
          "text": "自热带暖海中钓起的带刺河豚，浑身布满尖锐硬刺。虽然带有剧烈的神经剧毒与恶心麻痹，却是炼制水下呼吸魔药不可替代的至宝。",
          "color": "gray",
          "italic": true
        }
      ]
    },
