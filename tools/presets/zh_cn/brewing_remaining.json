  "minecraft:rabbit_foot": {
    "base": {
      "loreJson": [
        {
          "text": "击败野兔罕见获得的幸运兔脚。风干后毛发柔软，自古便被游侠视作带来吉兆的护身符，更是炼制强效跳跃魔药的核心圣材。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:splash_potion": {
    "base": {
      "loreJson": [
        {
          "text": "混入烈性火药与魔药封存的弯颈琉璃瓶。用力投掷触地即碎，强烈的药力便会在空气中瞬间炸开一片惠及周围一切生灵的魔法迷雾。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:tipped_arrow": {
    "base": {
      "loreJson": [
        {
          "text": "箭尖蘸过药液，射中时能把这份药效一起带过去。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  }
}
