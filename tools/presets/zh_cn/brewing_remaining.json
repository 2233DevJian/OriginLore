{
  "minecraft:blaze_powder": {
    "base": {
      "loreJson": [
        {
          "text": "炽黄粉末摸着发暖，能给酿造台补火，也能配力量药水。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brewing_stand": {
    "base": {
      "loreJson": [
        {
          "text": "细管分出三个瓶位，添上烈焰粉才能把药慢慢酿起来。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dragon_breath": {
    "base": {
      "loreJson": [
        {
          "text": "紫色气息贴着瓶壁翻卷，是酿出滞留药雾的关键材料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:experience_bottle": {
    "base": {
      "loreJson": [
        {
          "text": "绿色光点浮在瓶里，摔开才能把积下的经验放出来。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:fermented_spider_eye": {
    "base": {
      "loreJson": [
        {
          "text": "发酵后的眼珠气味尖锐，足以把原有药性改个方向。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ghast_tear": {
    "base": {
      "loreJson": [
        {
          "text": "乳白小滴结成硬珠，拿去酿药能慢慢补回伤势。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glass_bottle": {
    "base": {
      "loreJson": [
        {
          "text": "薄玻璃围出一只小瓶，洗净后装水和收蜜都方便。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glistering_melon_slice": {
    "base": {
      "loreJson": [
        {
          "text": "金粒围住一片红瓤，虽然不能当饭，却能用来酿治疗药。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glowstone_dust": {
    "base": {
      "loreJson": [
        {
          "text": "金色细屑亮得均匀，少量就能增强某些药水的效力。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gunpowder": {
    "base": {
      "loreJson": [
        {
          "text": "灰黑粉末细而干，混进配方后会让平常物件有爆裂的本事。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lingering_potion": {
    "base": {
      "loreJson": [
        {
          "text": "稠密药液在瓶里转得很慢，落地碎开后会留下一团药雾。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:magma_cream": {
    "base": {
      "loreJson": [
        {
          "text": "橙色黏团裹着热意，酿出的药能让人经得起火。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:nether_wart": {
    "base": {
      "loreJson": [
        {
          "text": "暗红小粒结在短茎上，大多数药水都从它开头。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ominous_bottle": {
    "base": {
      "loreJson": [
        {
          "text": "蓝色瓶液显得阴沉，打开喝下会招来不祥的兆头。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:phantom_membrane": {
    "base": {
      "loreJson": [
        {
          "text": "薄膜轻韧透光，既能补鞘翅，也能酿出缓降药。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:potion": {
    "base": {
      "loreJson": [
        {
          "text": "药液在细颈瓶里轻晃，效力要看其中实际酿进了什么。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
