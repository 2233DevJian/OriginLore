  "minecraft:rabbit_foot": {
    "base": {
      "loreJson": [
        {
          "text": "细骨裹着短绒，酿进药水能让脚下多些弹力。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:splash_potion": {
    "base": {
      "loreJson": [
        {
          "text": "瓶口封得很紧，薄壳掷碎后药液会洒向周围。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:tipped_arrow": {
    "base": {
      "loreJson": [
        {
          "text": "箭尖蘸过药液，射中时能把这份药效一起带过去。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  }
}
