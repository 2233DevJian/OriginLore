        {
          "text": "薄薄一层羊毛，铺在地上能把脚步声压下去。白色干净，适合衬亮暗处。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:white_concrete": {
    "base": {
      "loreJson": [
        {
          "text": "粉末遇水凝成的硬块，敲上去声音发闷。白色干净，适合衬亮暗处。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:white_concrete_powder": {
    "base": {
      "loreJson": [
        {
          "text": "装袋的粉末，沾水就凝住，别让它淋着雨。白色干净，适合衬亮暗处。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:white_dye": {
    "base": {
      "loreJson": [
        {
          "text": "磨细的颜料，染羊毛、染陶瓦、染玻璃都用得上。白色干净，适合衬亮暗处。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:white_glazed_terracotta": {
    "base": {
      "loreJson": [
        {
          "text": "窑里烧出来的釉面，转个角度能看见光在走。白色干净，适合衬亮暗处。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:white_shulker_box": {
    "base": {
      "loreJson": [
        {
          "text": "两片潜影壳夹着一只箱子，敲碎了里面的东西也不会掉出来。白色干净，适合衬亮暗处。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:white_stained_glass": {
    "base": {
      "loreJson": [
        {
          "text": "颜料熔进了玻璃里，透光，但不透景。白色干净，适合衬亮暗处。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:white_stained_glass_pane": {
    "base": {
      "loreJson": [
        {
          "text": "薄玻璃片，装窗比整块省料，也更容易碎。白色干净，适合衬亮暗处。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:white_terracotta": {
    "base": {
      "loreJson": [
        {
          "text": "黏土入窑烧成的素坯，颜色沉得住，不怕日晒。白色干净，适合衬亮暗处。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:white_wool": {
    "base": {
      "loreJson": [
        {
          "text": "剪下来洗净再压实的羊毛，按上去还是软的。白色干净，适合衬亮暗处。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:yellow_banner": {
    "base": {
      "loreJson": [
        {
          "text": "布面上还留着织机的压痕，图案得自己绣。黄色鲜明，做标记很容易找。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:yellow_bed": {
    "base": {
      "loreJson": [
        {
          "text": "木板和羊毛拼的床，够一个人睡；放哪儿都行，别挡着门。黄色鲜明，做标记很容易找。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:yellow_candle": {
    "base": {
      "loreJson": [
        {
          "text": "蜂蜡裹住一段细绳，点亮之后能烧很久。黄色鲜明，做标记很容易找。",
          "color": "yellow",
          "italic": true
        }
      ]
    }
  },
