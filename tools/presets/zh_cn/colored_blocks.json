      ]
    }
  },
  "minecraft:gray_concrete_powder": {
    "base": {
      "loreJson": [
        {
          "text": "干燥细腻的深灰矿粉颗粒，一旦倾入水中便会立刻凝固为坚固平整的深灰混凝土方块。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gray_dye": {
    "base": {
      "loreJson": [
        {
          "text": "墨粉与骨粉精妙调和出的深灰染料，色调温和沉稳，深受修道院织工与石雕画师的推崇。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gray_glazed_terracotta": {
    "base": {
      "loreJson": [
        {
          "text": "经高温窑火煅烧出的深灰彩釉瓷砖，表面盘旋着交错相扣的几何锁链纹，在火光照耀下流转着内敛的釉光。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gray_shulker_box": {
    "base": {
      "loreJson": [
        {
          "text": "染成深灰色泽的潜影盒，外表低调内敛，无论随身携带还是埋入石壁，都能安全维系属于你的移动秘库。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gray_stained_glass": {
    "base": {
      "loreJson": [
        {
          "text": "熔合深灰矿渣烧制的透光玻璃，能将强烈的正午烈日过滤为温和平静的柔光，营造出肃穆静谧的室内光影。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gray_stained_glass_pane": {
    "base": {
      "loreJson": [
        {
          "text": "纤薄的深灰色玻璃薄片，镶嵌在城堡外窗上既能遮蔽过分强烈的日光，又为建筑平添了一份冷峻的气魄。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gray_terracotta": {
    "base": {
      "loreJson": [
        {
          "text": "烧结紧密的深灰陶土素坯，带着如风蚀岩壁般粗粝厚重的质感，耐磨防风，是构筑古典要塞的上乘选料。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gray_wool": {
    "base": {
      "loreJson": [
        {
          "text": "浸透深灰染料的蓬松羊毛，触感柔软保暖，常用于编织巡林斥候的夜行斗篷与保暖被褥。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_banner": {
    "base": {
      "loreJson": [
        {
          "text": "染就森林深绿的长幅羊毛战旗，在林地哨塔上随风飘扬，象征着大自然的生生不息与林地守卫者的威严。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_bed": {
    "base": {
      "loreJson": [
        {
          "text": "铺着翠绿羊毛毯的舒适木床，散发着如林间初雨般的清新气息，让疲惫的旅人仿佛安眠于繁茂的树荫之下。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_candle": {
    "base": {
      "loreJson": [
        {
          "text": "掺入仙人掌绿浆浸润的深绿蜡烛，点燃时火光金黄平稳，散发着草木微弱的清香，营造出宁静祥和的自然氛围。",
          "color": "yellow",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_carpet": {
    "base": {
      "loreJson": [
        {
          "text": "剪裁整齐的深绿羊毛地毯，铺在木地板上宛若铺设了一条柔软的林间苔藓步道，步履无声。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_concrete": {
    "base": {
      "loreJson": [
        {
          "text": "遇水硬化的深绿人造石材，表面平整纯净无纹理，是构筑宏伟花园宫殿与自然立面的现代用料。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_concrete_powder": {
    "base": {
      "loreJson": [
        {
          "text": "干燥细腻的深绿矿粉颗粒，一旦接触水流便会迅速凝结为坚固致密的深绿色混凝土方块。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_dye": {
    "base": {
      "loreJson": [
        {
          "text": "熔炉高温烘烤仙人掌萃取出的深绿染料，色泽浓郁自然，是纺织品与陶瓦着色的经典植物染剂。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_glazed_terracotta": {
    "base": {
      "loreJson": [
        {
          "text": "高温烧结的翠绿琉璃瓷砖，表面盘旋着如藤蔓舒展般的繁复花纹，在火光映照下散发着温润如玉的光泽。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_shulker_box": {
    "base": {
      "loreJson": [
        {
          "text": "染成森林深绿色的潜影盒，坚固异常，宛如一座便携的虚空百宝箱，时刻妥善收纳着行者的探险珍藏。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_stained_glass": {
    "base": {
      "loreJson": [
        {
          "text": "熔铸绿铜矿物烧制的透光玻璃，阳光穿透时在室内投下如漫步于幽静雨林般的葱郁绿芒。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_stained_glass_pane": {
    "base": {
      "loreJson": [
        {
          "text": "纤薄的翠绿玻璃薄片，镶嵌于温室窗棂上，既能接引充足日光，又为建筑增添了一份生机盎然的诗意。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_terracotta": {
    "base": {
      "loreJson": [
        {
          "text": "烧结紧密的深绿陶土素坯，色调偏向沉稳内敛的橄榄褐绿，坚硬耐候，极富古老大地神庙的肃穆质感。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:green_wool": {
    "base": {
      "loreJson": [
        {
          "text": "浸染纯正森林绿的蓬松羊毛，触感柔软厚实，常用于缝制德鲁伊法袍与装点宏伟的大厅挂毯。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:light_blue_banner": {
    "base": {
      "loreJson": [
        {
          "text": "布面上还留着织机的压痕，图案得自己绣。浅蓝清淡，和白色并排很协调。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:light_blue_bed": {
    "base": {
      "loreJson": [
        {
          "text": "木板和羊毛拼的床，够一个人睡；放哪儿都行，别挡着门。浅蓝清淡，和白色并排很协调。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:light_blue_candle": {
    "base": {
      "loreJson": [
        {
          "text": "蜂蜡裹住一段细绳，点亮之后能烧很久。浅蓝清淡，和白色并排很协调。",
          "color": "yellow",
          "italic": true
        }
      ]
    }
  },
  "minecraft:light_blue_carpet": {
    "base": {
      "loreJson": [
        {
          "text": "薄薄一层羊毛，铺在地上能把脚步声压下去。浅蓝清淡，和白色并排很协调。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:light_blue_concrete": {
    "base": {
      "loreJson": [
        {
          "text": "粉末遇水凝成的硬块，敲上去声音发闷。浅蓝清淡，和白色并排很协调。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:light_blue_concrete_powder": {
    "base": {
      "loreJson": [
        {
          "text": "装袋的粉末，沾水就凝住，别让它淋着雨。浅蓝清淡，和白色并排很协调。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:light_blue_dye": {
    "base": {
      "loreJson": [
        {
          "text": "磨细的颜料，染羊毛、染陶瓦、染玻璃都用得上。浅蓝清淡，和白色并排很协调。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:light_blue_glazed_terracotta": {
    "base": {
      "loreJson": [
        {
          "text": "窑里烧出来的釉面，转个角度能看见光在走。浅蓝清淡，和白色并排很协调。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:light_blue_shulker_box": {
    "base": {
      "loreJson": [
        {
          "text": "两片潜影壳夹着一只箱子，敲碎了里面的东西也不会掉出来。浅蓝清淡，和白色并排很协调。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:light_blue_stained_glass": {
    "base": {
      "loreJson": [
        {
          "text": "颜料熔进了玻璃里，透光，但不透景。浅蓝清淡，和白色并排很协调。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
