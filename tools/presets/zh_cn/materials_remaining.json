{
  "minecraft:ancient_debris": {
    "base": {
      "loreJson": [
        {
          "text": "历经下界无尽烈焰煅烧的古老残骸。层叠的暗褐断面坚不可摧，唯有最高温的熔炉才能提炼出其中的精髓。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:angler_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "从古老沙土中拂出的陶器残片，依稀可见一尾游鱼的图腾，记述着失落时代的渔猎往事。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:archer_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "陶片断口参差，刻划着一位拉弓远射的古代射手，散发着来自旧时代的肃穆猎风。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:armadillo_scute": {
    "base": {
      "loreJson": [
        {
          "text": "犰狳蜕落的角质鳞甲，弧度贴身且韧性极佳，是编缀狼用护甲的绝佳天然防具材料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:arms_up_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "古代彩陶的碎片，上面描摹着双臂高举向天的古老姿态，仿佛在向未知的神明祈求丰收。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:beetroot_seeds": {
    "base": {
      "loreJson": [
        {
          "text": "粗糙坚硬的深褐小种粒，埋入松软湿润的耕地中，便能吸饱雨露长出深红的甜菜。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:blade_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "刻有锐利短剑图样的古代陶器残片，仿佛在默默诉说着失落帝国征伐与守卫的沙场往事。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:blaze_rod": {
    "base": {
      "loreJson": [
        {
          "text": "击败下界烈焰守卫获得的炽热晶柱，内部蕴含着永不熄灭的纯粹火能，握在手中依然灼热逼人。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bolt_armor_trim_smithing_template": {
    "base": {
      "loreJson": [
        {
          "text": "试炼密室中封存的古老锻造模版。借助锻造台将铆钉与锁栓纹路压印在护甲边缘，彰显严丝合缝的工匠遗风。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bone": {
    "base": {
      "loreJson": [
        {
          "text": "历经岁月风蚀的坚硬苍白骨骼，中空带髓，可用来驯服荒野孤狼，亦可研磨成滋养草木的肥料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bone_meal": {
    "base": {
      "loreJson": [
        {
          "text": "骨骼细细研磨成的白色骨粉，富含天然磷钙养分，轻轻一撒便能唤醒泥土深处的种子，使其瞬间抽枝拔节。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:book": {
    "base": {
      "loreJson": [
        {
          "text": "鞣制皮革精心装订的空白手抄本，纸页干爽细腻，静待学者记录见闻，或由法师承载玄奥的附魔符文。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:breeze_rod": {
    "base": {
      "loreJson": [
        {
          "text": "击败试炼密室旋风人缴获的幽蓝气旋之芯，拿在手中轻若无物，内部却禁锢着狂暴而呼啸的暴风之力。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brewer_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "沾染着风沙的古老彩陶残片，表面拓印着炼药长颈瓶的图腾，记述着旧日炼金术士们探寻魔药秘辛的岁月。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brick": {
    "base": {
      "loreJson": [
        {
          "text": "黏土捏制并经高温烈火烧透的赤红小砖，质地坚实方正，是搭建耐火壁炉与结实工坊的绝佳基材。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:burn_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "从废墟残灰中拂出的古老陶片，上面刻划着熊熊燃烧的烈焰徽记，见证着远古部落对火的崇拜。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:charcoal": {
    "base": {
      "loreJson": [
        {
          "text": "原木在窑中隔绝空气闷烧炭化而成的高热燃料，断面隐现木纹，是熔炼矿物与手作火把的坚实基础。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:clay_ball": {
    "base": {
      "loreJson": [
        {
          "text": "湿润柔软的黏土团，手感细腻冰凉，随手揉捏即可成型，送入熔炉便能烧结成一块坚硬的红砖。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:coast_armor_trim_smithing_template": {
    "base": {
      "loreJson": [
        {
          "text": "沉船废墟中打捞出的古老锻造模版。借助锻造台将如潮汐起伏般的流线型纹饰压印在护甲之上，彰显浪潮的庇佑。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:cocoa_beans": {
    "base": {
      "loreJson": [
        {
          "text": "摘自丛林巨木的成熟可可果荚豆粒，经过晒干烘焙后散发着迷人的浓香与微苦，是烘烤曲奇的灵魂。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:copper_ingot": {
    "base": {
      "loreJson": [
        {
          "text": "熔炼提纯的标准红铜锭，质地柔韧延展性好，是锻造避雷针、望远镜与各类精密构件的工业基石。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:creeper_banner_pattern": {
    "base": {
      "loreJson": [
        {
          "text": "绘有苦力怕面容图案的羊皮纸图样，在织布机旁能将这令人胆寒的炸裂图腾精准织入旗帜。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:danger_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "覆着沙尘的古代陶片，表面刻划着警示危险的古老符号，告诫后来者此地曾有不可言说的凶险。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:disc_fragment_5": {
    "base": {
      "loreJson": [
        {
          "text": "边沿参差断裂的神秘黑色唱片碎片。将散落九方的碎片重新拼合，便能复原那段尘封在地底的诡异低语。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dune_armor_trim_smithing_template": {
    "base": {
      "loreJson": [
        {
          "text": "沙漠神殿深处拂出的古老锻造模版。借助锻造台将如连绵沙丘般的流线波纹压印于护甲之上，尽显大漠苍茫。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:echo_shard": {
    "base": {
      "loreJson": [
        {
          "text": "远古城市幽匿核心剥落的暗青晶片。内部无声涌动着死亡与重生的幽邃波纹，是锻造追溯指针的关键秘宝。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:enchanted_book": {
    "base": {
      "loreJson": [
        {
          "text": "羊皮纸页间流淌着神秘星芒的奥术附魔书，字迹灼灼生辉，放上铁砧便能将古老的法术符文注入武器与铠甲之中。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ender_eye": {
    "base": {
      "loreJson": [
        {
          "text": "末影珍珠融合烈焰粉精炼出的空间之眼。放飞苍穹，它便会撕裂迷雾，执着地引领冒险者寻找深埋地底的要塞之门。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ender_pearl": {
    "base": {
      "loreJson": [
        {
          "text": "击败末影人缴获的幽暗珍珠，表面流转着墨绿微光。奋力掷出，空间便会将你的肉身瞬间拽拉至落点之处。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:explorer_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "刻画着孤独探险家跋涉身影的古代彩陶残片，在黄沙下埋藏万年，默默诉说着先驱者对未知世界的向往与求索。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:eye_armor_trim_smithing_template": {
    "base": {
      "loreJson": [
        {
          "text": "自要塞地牢深处挖掘出的古老锻造模版。借助锻造台将凝视虚空的眼形图腾压印于护甲胸心，彰显洞悉异界的古老智慧。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:feather": {
    "base": {
      "loreJson": [
        {
          "text": "自禽鸟双翼脱落的柔韧轻羽，羽轴笔直，羽丝整齐细密，既是校准箭矢破空飞行的尾羽，亦是学者饱蘸墨水抄写典籍的硬笔。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:flint": {
    "base": {
      "loreJson": [
        {
          "text": "自粗砾石堆中剥落的灰黑燧石片，质地坚硬，边缘锋利如刀，是打磨箭簇与擦碰火星最原始而不可或缺的矿石。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:flow_armor_trim_smithing_template": {
    "base": {
      "loreJson": [
        {
          "text": "自试炼密室旋风核心寻获的古老锻造模版。借助锻造台将回旋呼啸的气流纹理压印于护甲之上，彰显如风暴般的迅捷与狂野。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:flow_banner_pattern": {
    "base": {
      "loreJson": [
        {
          "text": "绘有旋风涡流图样的羊皮纸样，置于织布机旁，便能将流转不息的暴风印记织入高耸飘扬的战旗之中。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:flow_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "刻有回旋风纹的古代彩陶残片，线条飘逸，在漫长岁月里静静记述着古老部族对狂风与气流的崇拜。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:flower_banner_pattern": {
    "base": {
      "loreJson": [
        {
          "text": "绘有盛开雏菊轮廓的羊皮纸图样，在织布机上能引导丝线，将繁花锦簇的优雅图案细致织入旗帜之中。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
