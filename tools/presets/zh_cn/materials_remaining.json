    "base": {
      "loreJson": [
        {
          "text": "刻有两人携手相伴身姿的古代陶片，在岁月风沙中出土，依然散发着跨越千年时光、温暖人心的同伴情谊。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:globe_banner_pattern": {
    "base": {
      "loreJson": [
        {
          "text": "绘有经纬交织的宏伟地球图样的羊皮纸图样，在织布机上能将这象征着探索全境与浩瀚世界的宏伟图案织入旗帜之中。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glow_ink_sac": {
    "base": {
      "loreJson": [
        {
          "text": "自发光鱿鱼身上采得的发光墨囊。黏稠的墨液中闪烁着梦幻的青蓝萤光，涂抹在木牌告示上能让字迹在至暗之夜中清晰夺目。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gold_ingot": {
    "base": {
      "loreJson": [
        {
          "text": "熔炼提纯的标准黄金金条，色泽温润尊贵，不仅是打造动力铁轨与计时怀表的必备良材，更是下界与猪灵以物易物的无上硬通货。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gold_nugget": {
    "base": {
      "loreJson": [
        {
          "text": "细碎闪亮的小金粒，沉淀在掌心泛着迷人的黄光，可用于包裹闪烁西瓜、精制金胡萝卜，亦能九粒聚炼为一块沉甸甸的金锭。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:guster_banner_pattern": {
    "base": {
      "loreJson": [
        {
          "text": "绘有旋风眼与狂暴气流轮廓的羊皮纸样，置于织布机旁，便能将试炼密室狂风的印记织入高耸战旗之中。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:guster_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "刻有旋风咆哮轮廓的古老彩陶残片，在泥沙中拂拭而出，依然清晰可见远古先民对暴风神力的敬畏与崇拜。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:heart_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "刻有完整心形图腾的古代彩陶残片，出土于远古沙土之下，在岁月流逝中依然向世人传递着爱与誓言的温存。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:heartbreak_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "刻有破碎裂心图案的古老彩陶残片，在残垣断壁中诉说着古代悲剧、离别与失落誓言的苍凉往事。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
