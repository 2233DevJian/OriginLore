    "base": {
      "loreJson": [
        {
          "text": "试炼密室核心宝库中封存的沉重暗铁方块。密度惊人，握在掌中重若千钧，是锻造击碎万物的破阵重锤之核心。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:honeycomb": {
    "base": {
      "loreJson": [
        {
          "text": "挂着清香蜜露的六角蜡质蜂房块，柔韧纯净，不仅能用于封蜡铜块阻止生锈，更是制作蜂箱与蜡烛的天然绝佳材料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:host_armor_trim_smithing_template": {
    "base": {
      "loreJson": [
        {
          "text": "自远古废墟沙土中拂出的古老锻造模版。借助锻造台将沉稳庄重的古纹压印于护甲边缘，彰显失落古国领主的威严气度。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:howl_pottery_sherd": {
    "base": {
      "loreJson": [
        {
          "text": "刻有苍狼仰天长嚎身姿的古代彩陶残片，线条粗犷而充满野性，记录着荒古猎人与狼群并肩作战的岁月。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ink_sac": {
    "base": {
      "loreJson": [
        {
          "text": "自深水鱿鱼体内剥取的墨囊，囊内封存着浓稠漆黑的天然墨汁，是制作深黑染料与学者饱蘸羽毛笔书写大卷的传统原料。",
          "color": "gray",
          "italic": true
        }
