  "minecraft:iron_nugget": {
    "base": {
      "loreJson": [
        {
          "text": "熔炼废料或装备分解得来的微小铁粒，沉甸甸地落在掌心，九粒聚炼便能重新熔铸为一块完整的标准铁锭。",
          "color": "gray",
          "italic": true
        }
      ]
