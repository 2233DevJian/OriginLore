    "base": {
      "loreJson": [
        {
          "text": "散发着深邃海蓝色泽的天然矿石粉晶，触手冰凉，不仅是染制群青织物的上乘原料，更是附魔台上激活远古秘术不可或缺的媒介。",
          "color": "gray",
          "italic": true
        }
      ]
    }
