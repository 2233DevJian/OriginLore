{
  "minecraft:acacia_leaves": {
    "base": {
      "loreJson": [
        {
          "text": "疏朗开阔的灰绿细叶，在旱地强烈的日照下投出斑驳清凉的树荫。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:acacia_sapling": {
    "base": {
      "loreJson": [
        {
          "text": "柔韧的幼苗，根系虽然纤细，却深藏着日后长成遮天华盖的蓬勃生机。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:allium": {
    "base": {
      "loreJson": [
        {
          "text": "细碎的紫红小花聚成一团绒球，在微风中轻轻摇曳，散发着草木的清香。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:amethyst_cluster": {
    "base": {
      "loreJson": [
        {
          "text": "从母岩深处自然绽放的紫晶簇，簇尖剔透锋利，折射着地底幽微的微光。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:azalea": {
    "base": {
      "loreJson": [
        {
          "text": "繁茂温润的灌木幼株，小巧深绿的叶片密密丛生，常预示着地底深处藏有繁茂的洞穴。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:azalea_leaves": {
    "base": {
      "loreJson": [
        {
          "text": "紧密交织的嫩绿叶片，清香扑鼻，修剪后能作为天然优雅的花园绿篱。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:azure_bluet": {
    "base": {
      "loreJson": [
        {
          "text": "浅白泛蓝的娇小花瓣簇拥着鹅黄的花蕊，低低开在草甸边缘，格外清新可爱。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bamboo": {
    "base": {
      "loreJson": [
        {
          "text": "节段分明、中空外韧的青翠长竹，既能编扎轻便的高空脚手架，也能加工成结实的建筑料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:basalt": {
    "base": {
      "loreJson": [
        {
          "text": "下界熔岩与灵魂土交融凝固而成的黑色柱状玄武岩，纹理纵向延伸，冷硬而厚重。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bee_nest": {
    "base": {
      "loreJson": [
        {
          "text": "悬挂在繁花林木间的天然蜂巢，薄蜡层叠封裹着滴落蜜汁的脾房，内里隐隐传来群蜂劳作的嗡鸣。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:beehive": {
    "base": {
      "loreJson": [
        {
          "text": "细致打磨的人造蜂箱，内部设有规整的引蜜槽板，为蜜蜂提供了抵御风雨的安稳家园。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:big_dripleaf": {
    "base": {
      "loreJson": [
        {
          "text": "繁茂洞穴中生长出的硕大叶片，柔韧宽阔。旅人可借其借力跃升，但若停留过久，叶面便会顺从重力垂首倾斜。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:birch_leaves": {
    "base": {
      "loreJson": [
        {
          "text": "细薄轻盈的翠绿桦树叶，在春风拂过时沙沙作响，透下斑驳而柔和的林间日光。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:birch_sapling": {
    "base": {
      "loreJson": [
        {
          "text": "挺拔纤细的白桦幼苗，细嫩的枝条迎风微颤，只需一片阳光便能长成银白的林木。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:blue_ice": {
    "base": {
      "loreJson": [
        {
          "text": "极北冰原深处在万年重压下形成的纯净深蓝坚冰，质地密不透气，哪怕在烈火旁也极难融化，表面光滑至极。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:blue_orchid": {
    "base": {
      "loreJson": [
        {
          "text": "隐匿于迷雾沼泽深处的罕见蓝兰花，花瓣如轻盈的蓝色蝶翼，为阴暗泥泞的湿地带来一抹清冽的异香。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brain_coral": {
    "base": {
      "loreJson": [
        {
          "text": "生长于温润暖海中的粉红脑纹珊瑚，褶皱宛若活体脉络，离开海水后便会迅速石化褪色。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brain_coral_block": {
    "base": {
      "loreJson": [
        {
          "text": "珊瑚虫世代繁衍堆叠出的坚固脑纹珊瑚礁块，沉在蔚蓝海底，构筑起绚烂的水下迷宫基底。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brain_coral_fan": {
    "base": {
      "loreJson": [
        {
          "text": "如精美绸扇般在洋流中舒展的粉红珊瑚扇，随波荡漾，为暗礁岩壁点缀上一抹柔和的生机。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brown_mushroom": {
    "base": {
      "loreJson": [
        {
          "text": "阴暗潮湿处采摘的褐伞野菇，菌盖肥厚多汁，切片投入浓汤中熬煮能激发出浓郁的鲜味。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brown_mushroom_block": {
    "base": {
      "loreJson": [
        {
          "text": "巨型蘑菇伞盖切下的海绵状肉质方块，质地疏松多孔，带有浓郁的阴湿泥土清香。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bubble_coral": {
    "base": {
      "loreJson": [
        {
          "text": "绽放在热带暖海里的深紫气泡珊瑚，顶端结满圆润的泡状囊体，随着暗涌轻轻晃动。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bubble_coral_block": {
    "base": {
      "loreJson": [
        {
          "text": "由无数紫色泡状珊瑚钙化凝结而成的重型礁石方块，沉稳如墨，是水下生物穿梭的乐园。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bubble_coral_fan": {
    "base": {
      "loreJson": [
        {
          "text": "如羽扇般向外铺展的紫色气泡珊瑚扇，在碧蓝洋流中舒展叶片，散发着深海独有的绮丽。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:cactus": {
    "base": {
      "loreJson": [
        {
          "text": "耸立在烈日荒漠中的多肉仙人掌，肥厚的青绿表皮下储满水分，外侧密布的硬刺则告诫着鲁莽的过客。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:calcite": {
    "base": {
      "loreJson": [
        {
          "text": "伴随紫晶洞地质共生的乳白方解石，质地温润如白玉，砌在深色石壁旁能形成高雅明亮的对比。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:carved_pumpkin": {
    "base": {
      "loreJson": [
        {
          "text": "挖空南瓜瓤并用匕首刻出狰狞面容的幽灵面具。套在头上能遮蔽视线，从而直视末影人而不受攻击。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:cherry_leaves": {
    "base": {
      "loreJson": [
        {
          "text": "繁密娇嫩的粉红樱花簇，微风拂过便会飘落漫天如雪的花瓣，是春日山峦最绚烂的盛装。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:cherry_sapling": {
    "base": {
      "loreJson": [
        {
          "text": "顶端缀着一小撮粉红花蕾的樱树幼苗，扎根沃土之后，便能化作山间那一抹遮天蔽日的浪漫粉霞。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:chorus_flower": {
    "base": {
      "loreJson": [
        {
          "text": "绽放在紫颂植株顶端的白紫硬瓣花朵，是采摘紫颂果的关键节点，植于末地石上能再次抽枝绽放。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:clay": {
    "base": {
      "loreJson": [
        {
          "text": "浅水河床沉积出的细腻灰蓝黏土块，不含砂砾，是制陶烧砖与搭建防水炉台最朴素的大地馈赠。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:coarse_dirt": {
    "base": {
      "loreJson": [
        {
          "text": "泥土中夹杂着大量细碎砂砾与卵石，排水极佳且质地紧实，即便在湿润的环境下也不会轻易滋生杂草。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:cobweb": {
    "base": {
      "loreJson": [
        {
          "text": "废弃矿井与阴暗角落中密布的巨型蛛丝网，黏性惊人且坚韧异常，任何踏入其中的生物都会步履维艰。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:cornflower": {
    "base": {
      "loreJson": [
        {
          "text": "开在平原阳光下的幽蓝矢车菊，细密花瓣如放射状的星芒，是萃取鲜艳蓝色染料的天然上等来源。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:crimson_fungus": {
    "base": {
      "loreJson": [
        {
          "text": "散发着微光的深红厚伞菌菇，生长在绯红菌岩之上，用骨粉催化即可疯长为参天巨型菌木。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:crimson_nylium": {
    "base": {
      "loreJson": [
        {
          "text": "覆满活性深红菌丝层的地狱岩，宛如活物般蠕动呼吸，是培育绯红菌与下界植被的肥沃苗床。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:crimson_roots": {
    "base": {
      "loreJson": [
        {
          "text": "在深红菌岩上蔓延生长的扭曲细小菌根，如同暗红的珊瑚触手，为下界荒漠增添了一抹诡异的生机。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:crying_obsidian": {
    "base": {
      "loreJson": [
        {
          "text": "渗出幽紫液滴的古老黑曜石。裂痕中涌动着奇异的末地与地脉残响，是构筑重生锚并绑定灵魂坐标的核心圣物。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dandelion": {
    "base": {
      "loreJson": [
        {
          "text": "盛开在原野微风中的金黄蒲公英，花盘细碎灿烂，采下一捧便能研磨出最纯朴的明黄染料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dark_oak_leaves": {
    "base": {
      "loreJson": [
        {
          "text": "层叠密匝的浓绿树叶，枝叶繁茂近乎遮天蔽日，在黑森林的林冠下筑起常年不散的阴影。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dark_oak_sapling": {
    "base": {
      "loreJson": [
        {
          "text": "根系短小却生机沉雄的深色橡木幼苗。四株并植于沃土之中，方能拔地而起化作参天巨树。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_brain_coral": {
    "base": {
      "loreJson": [
        {
          "text": "失去潮汐滋养而钙化干涸的灰白脑纹珊瑚，生机尽褪，只留下一簇如枯骨般嶙峋的古怪石壳。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_brain_coral_block": {
    "base": {
      "loreJson": [
        {
          "text": "枯死干涸的脑纹珊瑚硬块，灰白多孔，虽已无生命的跳动，却依旧保留着远古洋底礁石的坚硬质地。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_brain_coral_fan": {
    "base": {
      "loreJson": [
        {
          "text": "曾经在波浪中摇曳的粉红珊瑚扇，如今已彻底风干硬化为一柄苍白的石质枯扇。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_bubble_coral": {
    "base": {
      "loreJson": [
        {
          "text": "离水风干后的气泡珊瑚残片，原本明艳的紫意散尽，只余下干瘪粗糙的灰白石囊。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_bubble_coral_block": {
    "base": {
      "loreJson": [
        {
          "text": "钙化凝结的死气泡珊瑚厚块，灰暗冷硬，曾是繁茂水下生灵的乐土，如今只余风蚀残痕。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_bubble_coral_fan": {
    "base": {
      "loreJson": [
        {
          "text": "风干石化的气泡珊瑚扇，叶片苍白发脆，静静诉说着海潮退去后的枯寂。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_bush": {
    "base": {
      "loreJson": [
        {
          "text": "伫立于荒漠与恶地狂风中的枯干灌木，枝条脆硬，折断后能为流落绝境的旅人凑出几根生火的细枝。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_fire_coral": {
    "base": {
      "loreJson": [
        {
          "text": "烈火珊瑚脱水后的灰白遗骸，曾经如火焰般绽放的细枝如今已彻底石化，触手冰冷发涩。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_fire_coral_block": {
    "base": {
      "loreJson": [
        {
          "text": "大片枯死烈火珊瑚沉积而成的死礁岩块，灰白斑驳，沉重如寻常石料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_fire_coral_fan": {
    "base": {
      "loreJson": [
        {
          "text": "如枯焦树叶般的珊瑚扇，昔日的艳红早已被岁月漂洗为灰白，只留下脆薄的骨架。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_horn_coral": {
    "base": {
      "loreJson": [
        {
          "text": "失去水分的鹿角珊瑚残簇，曾经鲜黄的尖角已褪为枯败的灰白，质地脆而易碎。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_horn_coral_block": {
    "base": {
      "loreJson": [
        {
          "text": "由无数枯死角状珊瑚压合而成的礁块，苍白粗糙，沉睡在退潮后的荒滩上。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_horn_coral_fan": {
    "base": {
      "loreJson": [
        {
          "text": "灰白石化的角状珊瑚扇面，曾经在水中舒展如画，如今只余苍凉的骨相。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_tube_coral": {
    "base": {
      "loreJson": [
        {
          "text": "曾经湛蓝的管状珊瑚枯枝，孔隙中已无洋流穿行，唯留灰白干脆的石质残骸。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_tube_coral_block": {
    "base": {
      "loreJson": [
        {
          "text": "枯死管状珊瑚积聚沉淀出的灰白石块，内部布满细密孔洞，带着海盐风干后的微涩气味。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dead_tube_coral_fan": {
    "base": {
      "loreJson": [
        {
          "text": "褪尽蓝色的管状珊瑚扇，干硬薄脆，在微风中静默地挺立着它风化后的轮廓。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dirt": {
    "base": {
      "loreJson": [
        {
          "text": "孕育万物的松软褐土，饱含水分与细碎根须，随手捏碎便能填平崎岖泥泞的荒野坑洼。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dripstone_block": {
    "base": {
      "loreJson": [
        {
          "text": "溶洞水流亿万年滴沥钙化沉淀出的棕色滴水石块，质地多孔，上下皆能孕育出尖锐锋利的石笋与钟乳石。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:end_stone": {
    "base": {
      "loreJson": [
        {
          "text": "构成末地虚空悬岛的淡黄陨石，表面布满风蚀小孔，质地比主界石头更加抗震坚固，能承受恶龙盘旋的重压。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:fern": {
    "base": {
      "loreJson": [
        {
          "text": "繁茂生长在阴湿林地间的羽状蕨草，细裂的青绿叶片迎风舒展，散发着针叶林早晨湿润清凉的泥土清香。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:fire_coral": {
    "base": {
      "loreJson": [
        {
          "text": "绽放在温暖浅海中的烈火珊瑚，枝杈分明如腾跃的红莲火焰，在碧蓝海水的冲刷下泛着明艳动人的赤红。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:fire_coral_block": {
    "base": {
      "loreJson": [
        {
          "text": "由无数烈火珊瑚虫累积钙化而成的赤红礁石方块，沉静厚重，构筑起海底珊瑚丛林最绚烂的基底。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:fire_coral_fan": {
    "base": {
      "loreJson": [
        {
          "text": "如烈焰般在水波中舒展的赤红珊瑚扇，随暗涌轻轻摆动，为海底悬崖与深壑点缀上一抹妖娆的绯色。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:flowering_azalea": {
    "base": {
      "loreJson": [
        {
          "text": "密叶间缀满粉紫小花的杜鹃花灌木，生机盎然，芬芳扑鼻，其在地表繁盛生长的根系往往暗示着下方幽深茂密的繁茂洞穴。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:flowering_azalea_leaves": {
    "base": {
      "loreJson": [
        {
          "text": "紧密交织的深绿杜鹃叶簇，点缀着无数娇嫩的粉色小花，修剪后是庄园与庭院中最为华美天然的花篱。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glow_lichen": {
    "base": {
      "loreJson": [
        {
          "text": "紧贴阴暗洞壁蔓延生长的苍白发光地衣，触感清凉潮湿，虽光线微弱，却足以驱散身旁的死寂暗影，照亮脚下的每一步。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:grass_block": {
    "base": {
      "loreJson": [
        {
          "text": "表层覆满青翠草皮的湿润沃土块，蕴含着蓬勃的自然生机，铺设开来便能顺着泥土慢慢蔓延成一片绿草如茵的开阔原野。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gravel": {
    "base": {
      "loreJson": [
        {
          "text": "大小不一的细碎卵石与粗砂堆积而成的松散方块，受重力易坍塌，用铁锹耐心筛洗翻找时常能捡获锋利的燧石片。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:hanging_roots": {
    "base": {
      "loreJson": [
        {
          "text": "自阴湿洞顶或巨树悬根处垂落的一簇细密树根，沾着微凉的水汽与湿土，为地下溶洞点缀上一抹原始苍茫的野趣。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:horn_coral": {
    "base": {
      "loreJson": [
        {
          "text": "生长在热带暖海中的金黄角状珊瑚，枝条如雄鹿昂角般错落分明，在清澈的海水中摇曳生姿，灿若黄金。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:horn_coral_block": {
    "base": {
      "loreJson": [
        {
          "text": "鹿角珊瑚群累积钙化而成的金黄礁石方块，坚硬厚重，在蔚蓝海底构筑起灿烂壮观的黄金礁脉。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:horn_coral_fan": {
    "base": {
      "loreJson": [
        {
          "text": "舒展如金绸羽扇的角状珊瑚扇面，在水波荡漾下轻轻翻卷，为海底礁壁披上一抹优雅高贵的金黄。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ice": {
    "base": {
      "loreJson": [
        {
          "text": "极北寒洋与高山湖泊凝结的半透明坚冰，内里封冻着细小的白色气泡，表面光滑至极，行路奔跑时极易打滑飞驰。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:jungle_leaves": {
    "base": {
      "loreJson": [
        {
          "text": "宽大厚实的深绿丛林树叶，层层叠叠如绿浪翻涌，能在暴雨倾盆的雨林中为下方的行者撑起一把天然的避雨巨伞。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:jungle_sapling": {
    "base": {
      "loreJson": [
        {
          "text": "柔韧挺拔的丛林木幼苗。四株并排齐种于沃土之上，便能拔地而起化作穿透云霄的参天巨木与藤蔓天梯。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:kelp": {
    "base": {
      "loreJson": [
        {
          "text": "自冰冷洋底向着阳光拔节疯长的滑腻海带，随波荡漾，烘烤脱水后便是便携耐嚼的干粮，亦可堆叠为高热燃料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:large_amethyst_bud": {
    "base": {
      "loreJson": [
        {
          "text": "在紫晶母岩上茁壮生长的粗壮紫晶簇幼芽，晶尖渐现锋芒，在幽暗地底折射出如梦似幻的幽紫微芒。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:large_fern": {
    "base": {
      "loreJson": [
        {
          "text": "宽大的羽状叶层层展开，适合填满林间的空处。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lilac": {
    "base": {
      "loreJson": [
        {
          "text": "淡紫花穗挤在高枝上，放在矮花后面也看得见。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lily_of_the_valley": {
    "base": {
      "loreJson": [
        {
          "text": "白色小铃沿细茎垂下，看着干净，却不宜放进食物里。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lily_pad": {
    "base": {
      "loreJson": [
        {
          "text": "扁圆的叶面浮在水上，脚踩过去时能撑住分量。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:magma_block": {
    "base": {
      "loreJson": [
        {
          "text": "下界熔岩与玄武岩交织凝结的高热岩块。黑色冷壳下裂开纵横交错的赤红火痕，赤足踏足其上会被灼伤皮肉。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:mangrove_leaves": {
    "base": {
      "loreJson": [
        {
          "text": "肥厚油亮的深绿红树叶簇，表面覆着防盐蜡质，在酷热多雨的沼泽上空交织成密不透风的翠绿穹顶。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:mangrove_propagule": {
    "base": {
      "loreJson": [
        {
          "text": "悬垂在红树枝头的细长绿芽胎生苗。脱落插入泥沼或水底沃土之中，便能迅速扎根，长成参天盘错的巨型红树。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:mangrove_roots": {
    "base": {
      "loreJson": [
        {
          "text": "粗壮木根盘根错节交织而成的孔状方块，透水透光，如巨型木爪般牢牢抓紧泥淖，支撑起整座雨林生态。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:medium_amethyst_bud": {
    "base": {
      "loreJson": [
        {
          "text": "从紫晶母岩上拔节抽出的中型紫晶簇，晶尖已然成型，在洞窟火把光晕下折射着清澈明丽的幽紫光斑。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:melon": {
    "base": {
      "loreJson": [
        {
          "text": "破土而出的墨绿条纹大西瓜，坚硬的外壳下蕴含着多汁鲜红的甜美果瓤，一刀切开便能化作数块解渴的甜果。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:moss_block": {
    "base": {
      "loreJson": [
        {
          "text": "繁茂洞穴中由极其厚实的天然苔藓汇聚成的深绿方块，触手如地毯般绵软湿润，使用骨粉便能迅速催化周遭石块化为青苔。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:moss_carpet": {
    "base": {
      "loreJson": [
        {
          "text": "剪裁平整的薄薄一层天然苔藓，铺在石阶或林地上能完美掩盖生硬的棱角，带来如漫步古老森林深处般的静谧与柔软。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:mud": {
    "base": {
      "loreJson": [
        {
          "text": "水流浸透沃土凝聚成的深褐湿润泥巴，踩上去黏软发陷，但在工匠手中混入麦秆烘干后便是制作泥砖的绝佳坯料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:muddy_mangrove_roots": {
    "base": {
      "loreJson": [
        {
          "text": "浸泡在深黑烂泥中的红树根系方块，泥根交错，饱含水分与沼泽腐殖质，是红树林生态深处最坚韧的地基。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:mushroom_stem": {
    "base": {
      "loreJson": [
        {
          "text": "巨型蘑菇拔地而起的高大菌柄方块，质地如海绵般轻软多孔，剥开后露出干爽的白色纤维，是绝妙的轻质建材。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:mycelium": {
    "base": {
      "loreJson": [
        {
          "text": "灰紫色菌丝密密铺在表面，足以让蘑菇在亮处生长。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:nether_sprouts": {
    "base": {
      "loreJson": [
        {
          "text": "在诡异菌岩上悄然破土的浅青嫩芽，细小微弱，散发着来自异界维度的冰冷萤光，触手冰凉柔韧。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:nether_wart_block": {
    "base": {
      "loreJson": [
        {
          "text": "由无数鲜红下界疣紧密挤压聚结而成的饱满方块，色泽浓郁如鲜血，常构成绯红巨型菌木那厚实肥硕的伞盖。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:netherrack": {
    "base": {
      "loreJson": [
        {
          "text": "构成下界广袤焦土的暗红地狱岩，质地酥脆多孔，一旦被火星引燃便会化为永不熄灭的熊熊烈焰。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:oak_leaves": {
    "base": {
      "loreJson": [
        {
          "text": "繁茂交织的翠绿橡树叶，微风吹拂时沙沙作响，偶尔会向树下的幸运行者掉落成熟清脆的红苹果与树苗。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:oak_sapling": {
    "base": {
      "loreJson": [
        {
          "text": "顶着嫩绿嫩叶的橡树幼苗，根系短小却饱含生机，只需一片阳光与泥土，便能拔地而起长成参天大树。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:obsidian": {
    "base": {
      "loreJson": [
        {
          "text": "水流与岩浆源相遇瞬间骤冷凝固的致密黑耀石。通体漆黑如渊，坚不可摧，是筑造下界传送门与末影箱的永恒基石。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:orange_tulip": {
    "base": {
      "loreJson": [
        {
          "text": "绽放在原野微风中的橙色郁金香，杯状花瓣如一簇静止的火苗，采摘后可研磨出纯正明丽的橙色染料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:oxeye_daisy": {
    "base": {
      "loreJson": [
        {
          "text": "开满平原草甸的滨菊，洁白狭长的花瓣簇拥着金黄的花蕊，朴素而优雅，是研磨浅灰染料与制作花卉旗帜图样的天然来源。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:packed_ice": {
    "base": {
      "loreJson": [
        {
          "text": "冰原深处在高压下致密凝结的浮冰方块，白中透青，即便置于烈火火把旁也绝不融化，滑行其上速度飞快。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:peony": {
    "base": {
      "loreJson": [
        {
          "text": "盛开于双格高枝上的重瓣粉红牡丹，花冠硕大娇艳，微风拂过时花香馥郁，是研磨大量娇艳粉红染料的天然上选。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:pink_petals": {
    "base": {
      "loreJson": [
        {
          "text": "自盛开樱树上随风飘落的粉红花瓣簇，铺在草甸上宛如一层芬芳的落雪，层层堆叠可汇聚成一片浪漫的花海地毯。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:pink_tulip": {
    "base": {
      "loreJson": [
        {
          "text": "绽放在原野微风中的粉红郁金香，杯状花冠亭亭玉立，花瓣娇嫩欲滴，采摘后可研磨出纯正优雅的粉红染料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:pitcher_plant": {
    "base": {
      "loreJson": [
        {
          "text": "由远古嗅探兽掘出的古老种子培育而成的双格高猪笼草，深蓝泛紫的囊状花冠古朴神秘，散发着失落时代的幽秘芬芳。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:podzol": {
    "base": {
      "loreJson": [
        {
          "text": "原始原始针叶林深处的灰化土方块，表层覆盖着厚厚一层未完全分解的落叶松针与腐殖质，肥沃湿润，杂草难侵。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:pointed_dripstone": {
    "base": {
      "loreJson": [
        {
          "text": "溶洞顶部垂挂或地面拔起的尖锐钟乳石锥，尖端长年滴沥水汽，从高处坠落或踏足其上皆会遭受穿膛破骨的刺穿剧痛。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:polished_basalt": {
    "base": {
      "loreJson": [
        {
          "text": "截面经过精细抛光的玄武岩柱，灰黑色的同心石纹在平滑表面下清晰可见，是搭建下界风情廊柱与庄重地面的极品用材。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:poppy": {
    "base": {
      "loreJson": [
        {
          "text": "盛开在原野微风中的鲜红虞美人，花瓣轻薄如绸，艳丽夺目，既是铁傀儡献给孩童的温柔誓言，亦能研磨出纯正明丽的红色染料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:pumpkin": {
    "base": {
      "loreJson": [
        {
          "text": "结在田垄蔓藤之上的金黄大南瓜，外皮厚实坚硬，既能掏空雕刻为幽灵面具，亦可切碎肉瓤烘焙为香甜浓郁的南瓜派。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:red_mushroom": {
    "base": {
      "loreJson": [
        {
          "text": "生长在阴暗潮湿处的鲜红伞盖斑点菇，色泽妖艳，切片与棕色蘑菇一同熬煮，便能化作香浓可口的蘑菇浓汤。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:red_mushroom_block": {
    "base": {
      "loreJson": [
        {
          "text": "巨型红蘑菇伞盖切下的肉质方块，表面如鲜艳红绸般点缀着白斑，质地轻软多孔，带着山林泥土特有的湿润清香。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:red_sand": {
    "base": {
      "loreJson": [
        {
          "text": "恶地峡谷风化崩解出的细密赤红沙粒，质地干爽松散，在荒漠狂风中漫天起伏，熔炼后可吹制为清澈透明的玻璃。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:red_tulip": {
    "base": {
      "loreJson": [
        {
          "text": "盛开在原野微风中的赤红郁金香，杯状花冠宛如一簇跳动的火苗，艳丽纯正，采摘后可研磨出纯正明丽的红色染料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:rooted_dirt": {
    "base": {
      "loreJson": [
        {
          "text": "盘根错节的粗壮树根穿透紧实的泥土方块，饱含地下湿气，常标志着上方正伫立着一株枝繁叶茂的参天杜鹃巨树。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:rose_bush": {
    "base": {
      "loreJson": [
        {
          "text": "盛开于双格高枝上的重瓣猩红玫瑰花丛，花盘硕大，芬芳扑鼻，是庭院庄园中最为华美尊贵的观赏花卉。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:sand": {
    "base": {
      "loreJson": [
        {
          "text": "荒漠与海岸随风起伏的细碎金黄沙粒，松散干爽，受重力影响易滑落坍塌，投入熔炉高温煅烧便能融为透亮的玻璃。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:sculk": {
    "base": {
      "loreJson": [
        {
          "text": "幽匿深渊中蔓延生长的诡异暗青有机物质，表面如星空般闪烁着微光，能悄无声息地吞噬并储藏周遭逝去生灵的经验精华。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:sculk_catalyst": {
    "base": {
      "loreJson": [
        {
          "text": "幽匿群系的核心催化石，散发着令人毛骨悚然的骨白与暗青微光。当生灵在其周围陨落时，它便会将死者灵魂化作狂暴蔓延的幽匿菌毯。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:sculk_shrieker": {
    "base": {
      "loreJson": [
        {
          "text": "环绕着骨白外壳的幽匿尖啸体。一旦感知到四周异动，内部便会激荡出一阵刺破灵魂的凄厉尖叫，在深渊深处唤醒沉睡的盲眼监守者。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:sculk_vein": {
    "base": {
      "loreJson": [
        {
          "text": "攀附在岩石表面蔓延如蛛网般的暗青幽匿脉络，半透明且透着微光，将幽匿深渊的生命力无声地延伸至每一个幽暗角落。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:sea_pickle": {
    "base": {
      "loreJson": [
        {
          "text": "生长在温润珊瑚礁岩上的海鞘群落，浸润于海水之中时会散发出柔和的黄绿萤光，聚集越密，光芒愈盛。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:seagrass": {
    "base": {
      "loreJson": [
        {
          "text": "扎根在浅海与河床泥沙中的翠绿海草，随着水波轻柔翻卷，是海龟最钟爱的天然饲料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:short_grass": {
    "base": {
      "loreJson": [
        {
          "text": "原野与丘陵上随风起伏的嫩绿短草，柔韧多汁，挥镰割倒时偶尔能抖落出几粒细小的麦种。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:small_amethyst_bud": {
    "base": {
      "loreJson": [
        {
          "text": "刚刚在紫晶母岩上萌发出的细小紫晶芽，晶莹微小，折射着地底洞窟中第一抹朦胧柔和的淡紫微光。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:small_dripleaf": {
    "base": {
      "loreJson": [
        {
          "text": "生长在繁茂洞穴水洼中的稚嫩垂滴叶，青翠欲滴，植于泥土或黏土之中，在骨粉滋养下能长成承托脚步的巨大叶片。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:smooth_basalt": {
    "base": {
      "loreJson": [
        {
          "text": "玄武岩在高温熔炉中再次煅烧软化后形成的平滑石方块，质地如深灰皮革般致密温润，常作为紫晶洞外壳的天然过渡层。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:sniffer_egg": {
    "base": {
      "loreJson": [
        {
          "text": "自海底废墟可疑沙土中拂出的史前巨蛋，红青相间的厚重外壳温热发沉，置于苔藓之上悉心照料便能孵化出远古嗅探兽。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:snow": {
    "base": {
      "loreJson": [
        {
          "text": "自苍穹洋洋洒洒飘落积聚的薄薄白雪层，踩上去发出清脆悦耳的咯吱微响，层层堆叠便能化作厚实的积雪方块。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:snow_block": {
    "base": {
      "loreJson": [
        {
          "text": "四捧晶莹雪球紧密压实铸就的纯白积雪方块，质地紧实洁白，不仅是堆砌雪人守卫的基石，亦能阻隔严寒筑起防风雪屋。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:soul_sand": {
    "base": {
      "loreJson": [
        {
          "text": "下界深渊堆积的暗褐怨魂之沙，表面如死者面容般扭曲蠕动，任何踏足其上的生灵都会被其无形的泥泞吸力死死拖慢步伐。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:soul_soil": {
    "base": {
      "loreJson": [
        {
          "text": "沉淀了千万年灵魂残骸的致密下界黑土，踩踏上去平稳干爽，引燃时便会腾起永不熄灭的幽蓝冰冷烈焰。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:spore_blossom": {
    "base": {
      "loreJson": [
        {
          "text": "倒悬于繁茂洞穴苍穹顶部的巨大粉紫花朵，缓缓开合花瓣，在空中源源不断地洒下如梦似幻、流转漂浮的翠绿发光孢子尘雾。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:spruce_leaves": {
    "base": {
      "loreJson": [
        {
          "text": "细密尖锐的深绿云杉松针叶簇，层层叠叠如厚实斗篷，在冰封高原上傲霜斗雪，散发着沁人心脾的松脂清香。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:spruce_sapling": {
    "base": {
      "loreJson": [
        {
          "text": "顶着墨绿松针的云杉幼苗。单株即可长成笔直尖塔，四株并植于沃土之中，更能拔地而起化作蔽日参天的巨型红杉。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:sugar_cane": {
    "base": {
      "loreJson": [
        {
          "text": "扎根在水岸泥沙旁的青翠高大甘蔗，茎秆多汁清甜，既能榨取雪白的纯糖，亦能压浆摊平晾晒为轻薄的纸张。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:sunflower": {
    "base": {
      "loreJson": [
        {
          "text": "永远执着昂首面朝初阳升起之处的璀璨向日葵，硕大的金黄花盘如燃烧的小太阳，是原野行者辨别东方的天然指南针。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:tall_grass": {
    "base": {
      "loreJson": [
        {
          "text": "原野与平原上高耸过膝的茂密青草丛，在劲风中如绿浪起伏，不仅能掩藏潜行猎手的身形，挥镰斩断时更能掉落丰富的麦种。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:torchflower": {
    "base": {
      "loreJson": [
        {
          "text": "由远古嗅探兽掘出的史前种子培育出的火把花，金红相间的花瓣如一团静止燃烧的炽热火炬，散发着来自失落纪元的古老芬芳。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:tube_coral": {
    "base": {
      "loreJson": [
        {
          "text": "绽放在温润暖海中的湛蓝管状珊瑚，孔隙分明如精巧的群管风琴，在清澈的海水中随波荡漾，散发着深海独有的绮丽。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:tube_coral_block": {
    "base": {
      "loreJson": [
        {
          "text": "由无数管状珊瑚累积钙化而成的湛蓝礁石方块，沉静厚重，构筑起海底珊瑚丛林最为深邃迷人的蓝色基底。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:tube_coral_fan": {
    "base": {
      "loreJson": [
        {
          "text": "如蓝绸羽扇般在洋流中舒展的管状珊瑚扇，随暗涌轻轻摆动，为海底悬崖与深壑点缀上一抹幽蓝深邃的海洋生机。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:turtle_egg": {
    "base": {
      "loreJson": [
        {
          "text": "海龟在温暖沙滩上产下的晶莹龟蛋，蛋壳脆弱，需悉心守护防止僵尸踩踏，在漫长月夜下便会破壳孵化出幼龟。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:twisting_vines": {
    "base": {
      "loreJson": [
        {
          "text": "扎根于下界诡异菌岩之上的青蓝扭曲藤蔓，如螺旋触手般向着虚空悬顶拔节疯长，是攀登下界高耸峭壁的天然梯索。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:vine": {
    "base": {
      "loreJson": [
        {
          "text": "自热带雨林巨木与沼泽树冠垂落的柔韧青藤，攀附在悬崖峭壁与粗糙树皮之上，是行者自如攀爬高崖的天然缆绳。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:warped_fungus": {
    "base": {
      "loreJson": [
        {
          "text": "散发着幽蓝冷光的奇特菌菇，生长在诡异菌岩之上。其特有的异界气味能让凶猛的炽足兽乖乖听话，亦能吓退狂躁的疣猪兽。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:warped_nylium": {
    "base": {
      "loreJson": [
        {
          "text": "覆满活性青蓝菌丝层的地狱岩，宛如活物般微微泛着冷光，是培育诡异菌与下界扭曲植被的肥沃苗床。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:warped_roots": {
    "base": {
      "loreJson": [
        {
          "text": "在青蓝菌岩上蔓延生长的扭曲细小菌根，如同异界的冷光珊瑚触手，为下界荒漠增添了一抹神秘的生机。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:warped_wart_block": {
    "base": {
      "loreJson": [
        {
          "text": "由无数青蓝变种下界疣紧密挤压聚结而成的饱满方块，色泽如幽邃冷玉，常构成诡异巨型菌木那厚实肥硕的伞盖。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:weeping_vines": {
    "base": {
      "loreJson": [
        {
          "text": "暗红藤蔓一节节垂下，挂在高处便是一条细软的梯子。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:white_tulip": {
    "base": {
      "loreJson": [
        {
          "text": "盛开在原野微风中的纯白郁金香，杯状花冠洁白无瑕，亭亭玉立，采摘后可研磨出纯正明丽的白色染料。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:wither_rose": {
    "base": {
      "loreJson": [
        {
          "text": "凋灵巨怪践踏掠夺生灵之后在死灰中绽放的漆黑玫瑰，花瓣如焦炭般脆弱，却持续散发着剥夺一切肉体生机的恐怖凋零剧毒。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  }
}
