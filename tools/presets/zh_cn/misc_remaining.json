{
  "minecraft:acacia_boat": {
    "base": {
      "loreJson": [
        {
          "text": "热带金合欢木削成的轻舟，船体泛着微暖的橙红，能在湍急的水流中平稳滑行。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:acacia_chest_boat": {
    "base": {
      "loreJson": [
        {
          "text": "结实的货舱与木舟连为一体，专为穿越漫长水路的长途旅人而准备。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bamboo_chest_raft": {
    "base": {
      "loreJson": [
        {
          "text": "竹筏中央紧紧绑扎着防雨储物箱，为独行的漂流者提供了充足的远航物资空间。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bamboo_raft": {
    "base": {
      "loreJson": [
        {
          "text": "粗壮竹竿紧密捆扎而成的漂流筏，吃水浅且浮力极佳，能载着两人顺流而下。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:birch_boat": {
    "base": {
      "loreJson": [
        {
          "text": "银白桦木板拼装的轻舟，在湖泊与水网间滑行时轻巧灵活，如同一片漂于水面的落叶。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:birch_chest_boat": {
    "base": {
      "loreJson": [
        {
          "text": "带有储物箱的白桦木小舟，为穿梭于清澈水道间的旅人提供了安全干燥的行囊安置处。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:bowl": {
    "base": {
      "loreJson": [
        {
          "text": "原木手工旋削出的小巧木碗，内壁刮磨得光滑平整，是盛放热汤与野味炖肉的必备餐具。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:cherry_boat": {
    "base": {
      "loreJson": [
        {
          "text": "粉嫩樱花木拼装的优雅轻舟，划动双桨时如一片落樱在水面泛起涟漪，浪漫而迅捷。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:cherry_chest_boat": {
    "base": {
      "loreJson": [
        {
          "text": "带有储物木箱的樱花木舟，为泛舟赏花或迁徙远方的旅人提供了安全整洁的物资空间。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:creeper_head": {
    "base": {
      "loreJson": [
        {
          "text": "完好剥离的苦力怕绿皮头颅，戴在头上能掩盖生灵气息，让荒野游荡的苦力怕难以及时察觉你的靠近。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dark_oak_boat": {
    "base": {
      "loreJson": [
        {
          "text": "深色橡木削就的厚重小舟，色如浓茶，在湍急林溪与幽深水域中行驶平稳如山。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dark_oak_chest_boat": {
    "base": {
      "loreJson": [
        {
          "text": "宽厚深色橡木舟内嵌设了一只大木箱，专为穿行于黑森林暗河的长途行商运载沉重行囊。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dragon_egg": {
    "base": {
      "loreJson": [
        {
          "text": "耸立在终末之池中央的巨型黑曜色龙卵。表壳泛着幽紫星芒，触碰时便会闪烁遁走，是击碎末地梦魇的无上荣耀。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dragon_head": {
    "base": {
      "loreJson": [
        {
          "text": "自末地船首斩落的末影龙威严首级。角刺高耸，连通红石脉冲时，深邃的巨口仍会开合咆哮。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:end_crystal": {
    "base": {
      "loreJson": [
        {
          "text": "悬浮于黑曜石底座上的末地水晶。粉红晶体缓缓旋转，涌动着维系末影巨龙生命的禁忌源能，受击便会发生剧烈爆炸。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:jungle_boat": {
    "base": {
      "loreJson": [
        {
          "text": "丛林红木削成的轻巧小舟，木质泛着温润的红褐，能在水草丛生、藤蔓交错的热带水网中穿梭自如。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:jungle_chest_boat": {
    "base": {
      "loreJson": [
        {
          "text": "带有储物木箱的丛林木小舟，为深入未开发热带雨林探险的拓荒者提供了防雨干燥的物资仓储空间。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:mangrove_boat": {
    "base": {
      "loreJson": [
        {
          "text": "红树木材削切而成的沉稳轻舟，木质耐水不腐，在浑浊泥泞的沼泽水网与错综复杂的树根间滑行轻快。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:mangrove_chest_boat": {
    "base": {
      "loreJson": [
        {
          "text": "带有防水储物箱的红树木舟，为深入泥泞红树林沼泽探险的行者提供了干燥安全的行囊空间。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_11": {
    "base": {
      "loreJson": [
        {
          "text": "破裂残缺的神秘黑胶唱片。放入唱片机中，传出的唯有沉重的喘息声、狂乱奔逃的脚步以及深渊中不可名状的诡异低语。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_13": {
    "base": {
      "loreJson": [
        {
          "text": "刻有古老凹槽的黑胶唱片。播放时伴随着悠远诡谲的金属回响与洞穴风啸，仿佛置身于远古矿井深不可测的暗影之中。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_5": {
    "base": {
      "loreJson": [
        {
          "text": "九块唱片残片重新拼合熔铸出的神秘黑胶。指针划过时，古老城市幽匿苏醒的恐惧与监守者的心跳在此刻重现世间。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_blocks": {
    "base": {
      "loreJson": [
        {
          "text": "泛着明快红橙色泽的黑胶唱片。旋律轻快跳跃，伴随欢畅的电子节拍，如同在一片生机盎然的方块原野上自由奔跑。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_cat": {
    "base": {
      "loreJson": [
        {
          "text": "经典的浅绿黑胶唱片。旋律如猫咪在阳光下漫步般慵懒俏皮，能让每一间避难所木屋瞬间充满温暖而安详的家的氛围。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_chirp": {
    "base": {
      "loreJson": [
        {
          "text": "带有深红标签的复古黑胶唱片。前奏伴随着留声机特有的微弱杂音，随后流淌出如老式八音盒般温馨怀旧的欢快圆舞曲。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_creator": {
    "base": {
      "loreJson": [
        {
          "text": "试炼密室宝库中封存的珍罕唱片。铜管乐与宏伟交响乐在其中激昂交织，歌颂着探索者面对无尽机关的勇气与创世奇迹。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_creator_music_box": {
    "base": {
      "loreJson": [
        {
          "text": "带有八音盒清脆音质的精巧黑胶唱片。音符如水晶坠落般叮咚作响，在静谧的夜空下流淌出如梦似幻的安眠曲调。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_far": {
    "base": {
      "loreJson": [
        {
          "text": "泛着碧绿光泽的宁静唱片。悠扬空灵的环境音效宛如拂过无垠原野的晚风，引人凝望地平线彼端未知的远方。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_mall": {
    "base": {
      "loreJson": [
        {
          "text": "泛着深紫光泽的优雅黑胶唱片。慵懒舒缓的爵士钢琴与空灵电音在厅堂回荡，是夜晚壁炉旁放松身心的绝妙乐章。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_mellohi": {
    "base": {
      "loreJson": [
        {
          "text": "带有白紫相间标签的古典唱片。哀而不伤的华尔兹手风琴曲调，宛如在雨夜烛光下独自起舞，带着一份淡淡的忧伤与诗意。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_otherside": {
    "base": {
      "loreJson": [
        {
          "text": "深埋要塞密室的稀世黑胶唱片。欢快明丽的复古钢琴乐段在耳畔层层递进，旋即化作让人振奋激昂的盛大冒险赞歌。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_pigstep": {
    "base": {
      "loreJson": [
        {
          "text": "自下界堡垒遗迹宝箱中掠得的至高黑胶。热烈狂放的下界嘻哈节奏重音轰鸣，展现出猪灵帝国最狂野、最不羁的灵魂。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_precipice": {
    "base": {
      "loreJson": [
        {
          "text": "试炼密室核心铸造的激昂战曲黑胶。电子合成重低音与管乐如暴风骤雨般交锋，令人心跳狂飙，热血沸腾。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_relic": {
    "base": {
      "loreJson": [
        {
          "text": "考古沙土中拂拭复原的远古唱片。带着留声机特有的微弱沙沙声，古朴欢快的八位元旋律仿佛带人重回文明初生的蛮荒黎明。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_stal": {
    "base": {
      "loreJson": [
        {
          "text": "纯黑如墨的经典黑胶唱片。悠扬随性的萨克斯管与轻柔爵士鼓点交织，带着浓厚的午夜酒馆风情，令人沉醉。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_strad": {
    "base": {
      "loreJson": [
        {
          "text": "泛着象牙白色泽的优雅唱片。热带木琴与温润电音在耳畔轻轻回荡，宛若漫步在落日余晖洒满海浪的金黄沙滩之上。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_wait": {
    "base": {
      "loreJson": [
        {
          "text": "带有天蓝标签的轻快唱片。欢畅明朗的旋律逐渐升华，如晨曦初升般拨云见日，给跋涉荒野的旅人带来无尽的希望。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:music_disc_ward": {
    "base": {
      "loreJson": [
        {
          "text": "带有墨绿标签的神秘黑胶。在短暂的肖邦葬礼进行曲引子之后，瞬间转入激昂欢快的电子节奏，兼具怪诞与奇妙的张力。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:oak_boat": {
    "base": {
      "loreJson": [
        {
          "text": "经典橡木精心削拼的坚固轻舟，船体干爽轻巧，两支木桨划动间能在平静湖面与湍急河流中自如穿梭。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:oak_chest_boat": {
    "base": {
      "loreJson": [
        {
          "text": "带有坚实储物木箱的传统橡木舟，为长途水路跋涉的探险者提供了遮风挡雨的干燥行囊储存空间。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:piglin_head": {
    "base": {
      "loreJson": [
        {
          "text": "完好剥离的猪灵头颅，长吻与尖牙依稀可见，通入红石脉冲时双耳仍会轻轻扇动，仿佛还在警惕着下界熔岩的风吹草动。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:skeleton_skull": {
    "base": {
      "loreJson": [
        {
          "text": "自倒下的骷髅射手身上斩落的风化苍白头骨，眼窝空洞幽深，戴在头上能大幅削弱同类亡灵对你的感知距离。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:spruce_boat": {
    "base": {
      "loreJson": [
        {
          "text": "北境云杉木板精心拼装的深沉小舟，木质耐寒抗冻，划动双桨时能在冰原浮冰与冷冽峡湾水系间平稳破浪前行。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:spruce_chest_boat": {
    "base": {
      "loreJson": [
        {
          "text": "带有厚实防水木箱的云杉木舟，为穿梭于漫长雪原暗河与高山湖泊的长途行者提供了安全干燥的物资储备处。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:totem_of_undying": {
    "base": {
      "loreJson": [
        {
          "text": "斩杀灾厄林地唤魔者夺得的黄金护身金像。紧握于副手，在遭受致命灭顶之灾的刹那，它便会化为漫天神圣光华，强行逆转死生。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:wither_skeleton_skull": {
    "base": {
      "loreJson": [
        {
          "text": "斩杀下界要塞凋灵骷髅斩获的焦黑头骨，散发着来自死界深渊的冰冷寒意。集齐三枚置于灵魂沙上，便能唤醒毁灭一切的三头凋灵。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:zombie_head": {
    "base": {
      "loreJson": [
        {
          "text": "自倒下的僵尸身上斩落的干枯深绿头颅，面容扭曲狰狞，戴在头上能掩盖生灵气息，大幅削弱游荡僵尸对你的警觉感知。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  }
}
