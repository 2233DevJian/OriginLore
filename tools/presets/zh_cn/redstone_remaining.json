      "loreJson": [
        {
          "text": "坚硬原石打磨而成的重型踏板，平铺于石质地面难以察觉，唯有活物生灵踏足其上时方会稳定触发红石信号。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:target": {
    "base": {
      "loreJson": [
        {
          "text": "优质干草捆与红石粉紧密压制而成的环形靶标。箭矢命中的位置越靠近红心，激发的红石脉冲便越发强劲持久。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:tnt": {
    "base": {
      "loreJson": [
        {
          "text": "精纯火药与粗干沙粒精密配比压实制成的烈性炸药方块。引信一点或红石一通，便会爆发出撕裂山峦、摧毁万物的毁灭轰鸣。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:tnt_minecart": {
    "base": {
      "loreJson": [
        {
          "text": "铁斗车厢内装载烈性TNT的特制冲锋矿车，沿着铁轨全速撞击或遭遇激活铁轨时，便会瞬间引发山崩地裂的巨力连环爆炸。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:trapped_chest": {
    "base": {
      "loreJson": [
        {
          "text": "木箱扣件连着细小机关，盖子一开就会惊动相邻线路。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:tripwire_hook": {
    "base": {
      "loreJson": [
        {
          "text": "坚硬木块、熟铁销钉与杠杆结构组装的绊线钩。两端拉起隐秘蛛丝，任何不经意的踩踏与穿行皆会瞬间引发致命的陷阱。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:warped_button": {
    "base": {
      "loreJson": [
        {
          "text": "诡异菌木心材车削出的小巧青蓝木钮，按压清脆柔和，通体防火，巧妙地融入下界幽暗奇异的青绿木质墙体之中。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:warped_pressure_plate": {
    "base": {
      "loreJson": [
        {
          "text": "诡异菌木打磨制成的防火踏板，平整隐秘，能够在滚烫熔岩湖畔稳定感应任何踩踏施加的重量。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:waxed_copper_bulb": {
    "base": {
      "loreJson": [
        {
          "text": "外壳涂蜡密封的红铜脉冲灯具。随接通信号灵动切换明灭，由于彻底隔绝了氧化，它将永远散发出最明亮炽烈的金黄光芒。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:waxed_exposed_copper_bulb": {
    "base": {
      "loreJson": [
        {
          "text": "表面带有淡淡暗斑并涂蜡封存的脉冲灯。随信号切换明灭，柔和温润的采光状态被蜂蜡永久保护，不再随岁月变暗。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:waxed_oxidized_copper_bulb": {
    "base": {
      "loreJson": [
        {
          "text": "铜壳覆满青绿铜锈并涂蜡封存的脉冲灯。厚重的氧化层赋予其永恒朦胧而柔和的幽光，随红石信号稳定切换明灭。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:waxed_weathered_copper_bulb": {
    "base": {
      "loreJson": [
        {
          "text": "铜壳布满斑驳绿锈并涂蜡保护的脉冲灯。伴随信号切换明灭，温和平静的幽暗采光状态被蜂蜡永久保护。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:weathered_copper_bulb": {
    "base": {
      "loreJson": [
        {
          "text": "铜壳已大面积被绿锈覆盖的脉冲灯具。随接通信号切换明灭，浓重的氧化层让其透射出的光线变得极其柔和与幽暗。",
          "color": "gray",
          "italic": true
        }
      ]
    }
  }
}
