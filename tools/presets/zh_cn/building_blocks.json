{
  "minecraft:bricks": {
    "base": {
      "loreJson": [
        {
          "text": "烧结红砖与灰浆交错咬合而成的结实砖墙块，经久耐火，自古便是城镇与烟囱的标志。",
          "color": "dark_red",
          "italic": true
        }
      ]
    }
  },
  "minecraft:oak_planks": {
    "base": {
      "loreJson": [
        {
          "text": "顺着木纹平整剖切出的经典橡木板，质地干爽坚韧，钉接紧密，是铺设地板与拼装家具的万用料材。",
          "color": "green",
          "italic": true
        }
      ]
    }
  },
  "minecraft:stone": {
    "base": {
      "loreJson": [
        {
          "text": "构成主界崇山峻岭与广袤地壳的坚硬原石方块，质地纯朴致密，在铁镐开采下会碎裂为圆石，亦是文明筑城的根本骨架。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:stone_bricks": {
    "base": {
      "loreJson": [
        {
          "text": "采掘原石经熔炼重塑后精密切割的石砖方块，砖缝规整平直，自古便是帝国修建宏伟城池与地下要塞的绝对基石。",
          "color": "white",
          "italic": true
        }
      ]
    }
  }
}
