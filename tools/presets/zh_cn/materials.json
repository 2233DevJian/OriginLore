{
  "minecraft:amethyst_shard": {
    "base": {
      "loreJson": [
        {
          "text": "从晶簇上剥落的剔透晶片，质地轻脆，常用于光学透镜或精密仪器的校准。",
          "color": "light_purple",
          "italic": true
        }
      ]
    }
  },
  "minecraft:coal": {
    "base": {
      "loreJson": [
        {
          "text": "亿万年地层沉降凝结出的纯黑化石燃料，容易引燃且燃烧持久，是照亮黑暗地底与驱使熔炉咆哮的不竭动力。",
          "color": "dark_gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:diamond": {
    "base": {
      "loreJson": [
        {
          "text": "地壳极深处历经亿万年高压淬炼而成的纯净晶体，棱角如刀锋般锐利，折射出冷冽而令人窒息的湛蓝光芒。",
          "color": "aqua",
          "italic": true
        }
      ]
    }
  },
  "minecraft:emerald": {
    "base": {
      "loreJson": [
        {
          "text": "散发着温暖碧绿光泽的纯净绿宝石。村民社会中唯一公认的硬通货币，是开启各行各业大宗交易的万能钥匙。",
          "color": "green",
          "italic": true
        }
      ]
    }
  },
  "minecraft:heart_of_the_sea": {
    "base": {
      "loreJson": [
        {
          "text": "深埋于海底藏宝箱中的湛蓝球形宝石。握在掌心湿润清凉，耳畔隐隐传来万顷碧波的涛声，是构筑潮涌核心的无上神物。",
          "color": "aqua",
          "italic": true
        }
      ]
    }
  },
  "minecraft:iron_ingot": {
    "base": {
      "loreJson": [
        {
          "text": "熔炉高温提纯浇铸的标准铁锭，成色均匀，质地坚韧，是打造整个文明工具、武器、盔甲与机械架构的不可动摇之基石。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:nether_star": {
    "base": {
      "loreJson": [
        {
          "text": "斩杀三头凋灵巨怪自虚无中夺得的至高神星。星芒璀璨灼目，蕴含着无可估量的创世神力，是筑造信标引动天地异象的绝对核心。",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:netherite_ingot": {
    "base": {
      "loreJson": [
        {
          "text": "四块远古下界合金碎片与四枚纯金锭在锻炉中熔合铸就的极品合金锭。沉重非凡，能在滚烫岩浆中从容浮沉，是凡器升华入圣的终极秘宝。",
          "color": "dark_gray",
          "italic": true
        }
      ]
    }
  }
}
