          "italic": true
        }
      ]
    }
  },
  "minecraft:name_tag": {
    "base": {
      "loreJson": [
        {
          "text": "A brass plate tied to a supple leather thong. Inscribed at an anvil and fastened to a creature, it binds a name across time, anchoring their soul to this world forever.",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:powder_snow_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "An iron pail packed with freezing, powdery drift-snow, creating treacherous deep banks that swallow and freeze any walker lacking leather boots.",
