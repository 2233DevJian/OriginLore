          "italic": true
        }
      ]
    }
  },
  "minecraft:milk_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "A sloshing iron pail filled with rich, creamy farm milk, cleansing the blood of virulent poisons and lingering hexes in a single gulp.",
