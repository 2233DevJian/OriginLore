          "italic": true
        }
      ]
    }
  },
  "minecraft:pufferfish_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "An iron pail carrying a live, bristling pufferfish in sloshing seawater, ready to populate exotic marine exhibits or guardian moats.",
