  "minecraft:goat_horn": {
    "base": {
      "loreJson": [
        {
          "text": "A curling horn sheared from a mountain goat's charge. Sounded with a deep breath, its haunting call carries miles across freezing peaks.",
          "color": "yellow",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lava_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "A bucket of lava that is still moving about. Best not to trip while carrying it.",
          "color": "red",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lead": {
    "base": {
      "loreJson": [
        {
          "text": "A knotted loop, tied to an animal at one end and a fence at the other. It works on other things as well.",
          "color": "green",
          "italic": true
        }
      ]
    }
  },
  "minecraft:map": {
    "base": {
      "loreJson": [
        {
          "text": "A clean sheet of pressed parchment, awaiting the surveyor's stride to chart unmapped terrain, coasts, and mountain passes.",
