{
  "minecraft:axolotl_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "An axolotl lying along the bottom of the bucket, its gills still moving slowly.",
          "color": "aqua",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brush": {
    "base": {
      "loreJson": [
        {
          "text": "A feather, a copper ingot, and a stick. Brushing suspicious sand is the only way to see what is under it.",
          "color": "green",
          "italic": true
        }
      ]
    },
    "sources": [
      {
        "type": "CRAFTING",
        "variants": [
          {
            "id": "handmade",
            "weight": 85,
            "qualityScore": 0.3,
            "rule": {
              "itemName": "Handmade Brush",
              "loreJson": [
                {
                  "text": "A feather, a copper ingot, and a stick. Brushing suspicious sand is the only way to see what is under it. The working end sits slightly off the handle and lacks a fine finish, making each task harder.",
                  "color": "gray",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                38,
                51
              ]
            }
          },
          {
            "id": "standard",
            "weight": 13,
            "qualityScore": 0.5,
            "rule": {
              "itemName": "Well-made Brush",
              "loreJson": [
                {
                  "text": "A feather, a copper ingot, and a stick. Brushing suspicious sand is the only way to see what is under it. A properly finished working end and a sound handle suit steady everyday work.",
                  "color": "white",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                64,
                64
              ]
            }
          },
          {
            "id": "refined",
            "weight": 2,
            "qualityScore": 0.9,
            "rule": {
              "itemName": "Refined Brush",
              "loreJson": [
                {
                  "text": "A feather, a copper ingot, and a stick. Brushing suspicious sand is the only way to see what is under it. An accurately shaped working end and a fitted handle put nearly every effort to use.",
                  "color": "blue",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                70,
                77
              ]
            }
          }
        ]
      }
    ]
  },
  "minecraft:bucket": {
