{
  "minecraft:axolotl_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "An iron bucket filled with fresh water and a resting axolotl, its delicate feathery gills swaying gently.",
          "color": "aqua",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brush": {
    "base": {
      "loreJson": [
        {
          "text": "A delicate horsehair brush pinned with copper, fashioned to sweep away centuries of dust without marring fragile relics.",
          "color": "green",
          "italic": true
        }
      ]
    },
    "sources": [
      {
        "type": "CRAFTING",
        "variants": [
          {
            "id": "handmade",
            "weight": 85,
            "qualityScore": 0.3,
            "rule": {
              "itemName": "Crude Feather Brush",
              "loreJson": [
                {
                  "text": "Feathers bound loosely to a whittled stick with soft copper wire. Uneven in the sweep, requiring a cautious hand among the sands.",
                  "color": "gray",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                38,
                51
              ]
            }
          },
          {
            "id": "standard",
            "weight": 13,
            "qualityScore": 0.5,
            "rule": {
              "itemName": "Field Archaeologist's Brush",
              "loreJson": [
                {
                  "text": "Balanced and neatly trimmed, its bristles sweep smoothly across suspicious gravel to reveal hidden artifacts unharmed.",
                  "color": "white",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                64,
                64
              ]
            }
          },
          {
            "id": "refined",
            "weight": 2,
            "qualityScore": 0.9,
            "rule": {
              "itemName": "Masterwork Excavation Brush",
              "loreJson": [
                {
                  "text": "Crafted from prime supple hair set into a counterbalanced copper ferrule, tracing ancient contours with whisper-soft precision.",
                  "color": "blue",
                  "italic": true
                }
              ],
              "maxDamageRange": [
                70,
                77
              ]
            }
          }
        ]
      }
    ]
  },
  "minecraft:bucket": {
    "base": {
      "loreJson": [
        {
          "text": "Beaten iron plates riveted into a sturdy pail, equally dependable for drawing deep well water or ladling molten rock.",
          "color": "green",
          "italic": true
        }
      ]
    }
  },
  "minecraft:carrot_on_a_stick": {
    "base": {
      "loreJson": [
        {
          "text": "A crisp carrot dangling just out of reach before a pig's snout, driving the beast into an eager, steerable gallop.",
          "color": "yellow",
          "italic": true
        }
      ]
    },
