  "minecraft:goat_horn": {
    "base": {
      "loreJson": [
        {
          "text": "A horn picked up where a goat charged into something. The sound it makes carries a very long way.",
          "color": "yellow",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lava_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "A bucket of lava that is still moving about. Best not to trip while carrying it.",
          "color": "red",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lead": {
    "base": {
      "loreJson": [
        {
          "text": "A knotted loop, tied to an animal at one end and a fence at the other. It works on other things as well.",
          "color": "green",
          "italic": true
        }
      ]
    }
  },
  "minecraft:map": {
    "base": {
      "loreJson": [
        {
          "text": "A sheet with nothing drawn on it yet. Once it has been used it starts recording everywhere you go.",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:milk_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "Freshly drawn milk, and one drink washes away most of the stranger things affecting you.",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:name_tag": {
    "base": {
      "loreJson": [
        {
          "text": "A blank iron tag. Once a name is written on it, whatever it is used on will never disappear.",
          "color": "white",
          "italic": true
        }
      ]
    }
  },
  "minecraft:powder_snow_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "A bucket holding snow that will not melt. Poured out, it will trap very nearly anything.",
          "color": "aqua",
          "italic": true
        }
      ]
    }
  },
  "minecraft:pufferfish_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "The pufferfish in here is holding a puff of air in reserve. Do not tip it out at your own feet.",
          "color": "yellow",
          "italic": true
        }
      ]
    }
  },
  "minecraft:recovery_compass": {
    "base": {
      "loreJson": [
        {
          "text": "The needle points at the last place you died. Uncomfortable to look at, but it does get your things back.",
          "color": "blue",
          "italic": true
        }
      ]
    }
  },
  "minecraft:saddle": {
    "base": {
      "loreJson": [
        {
          "text": "A leather saddle that can be fitted to a horse or a pig. It cannot be crafted — it has to be found.",
          "color": "blue",
          "italic": true
        }
      ]
    }
  },
  "minecraft:salmon_bucket": {
    "base": {
      "loreJson": [
        {
          "text": "A bucket of water and one salmon, which keeps circling round the inside.",
          "color": "aqua",
          "italic": true
        }
      ]
    }
  },
