{
  "minecraft:blaze_powder": {
    "base": {
      "loreJson": [
        {
          "text": "Glowing golden-red dust ground from a blaze's core, crackling with raw heat to fuel brewing stands and potent elixirs.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:brewing_stand": {
    "base": {
      "loreJson": [
        {
          "text": "A heavy stone plinth braced around a glowing blaze rod, holding glass flasks above blistering heat to brew transformative draughts.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:dragon_breath": {
    "base": {
      "loreJson": [
        {
          "text": "Swirling purple mist collected from an Ender Dragon's breath, pulsing with volatile planar magic for lingering potions.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:experience_bottle": {
    "base": {
      "loreJson": [
        {
          "text": "A glass flask filled with dancing green starlight, shattering upon the stones to shower the thrower in pure experience.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:fermented_spider_eye": {
    "base": {
      "loreJson": [
        {
          "text": "A spider's eye steeped in sugar and damp mushroom spores, its pungent dark brine capable of inverting gentle potions into sinister curses.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ghast_tear": {
    "base": {
      "loreJson": [
        {
          "text": "A crystallized tear harvested from a weeping Ghast, cool as marble and pulsing with potent regenerative magic for master brewers.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glass_bottle": {
    "base": {
      "loreJson": [
        {
          "text": "A clear blown-glass vial with a smooth lip, ready to draw river water, scoop sweet wild honey, or hold volatile magical brews.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glistering_melon_slice": {
    "base": {
      "loreJson": [
        {
          "text": "A slice of red melon gilded in pure gold nuggets, transformed from common fruit into a vital catalyst for restorative alchemy.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:glowstone_dust": {
    "base": {
      "loreJson": [
        {
          "text": "Brilliant golden dust crushed from Nether crystals, tingling with light and serving to empower potion potencies on the brewing stand.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:gunpowder": {
    "base": {
      "loreJson": [
        {
          "text": "Fine, dry grey-black sulfurous dust harvested from volatile horrors, crackling with dormant explosive fury at the slightest spark.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:lingering_potion": {
    "base": {
      "loreJson": [
        {
          "text": "Dense liquid turns slowly in the bottle and leaves a cloud after it breaks.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:magma_cream": {
    "base": {
      "loreJson": [
        {
          "text": "A warm, sticky lump harvested from magma cubes, holding dense elemental heat to brew miraculous elixirs of fire resistance.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:nether_wart": {
    "base": {
      "loreJson": [
        {
          "text": "A gnarled red fungus that festers only within soul sand, thick and bulbous, serving as the essential foundation for nearly every potent brew.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:ominous_bottle": {
    "base": {
      "loreJson": [
        {
          "text": "A dark vial swirling with ill-omened mist. Swallowing its bitter draught draws down the wrath of raids and trial spawner challenges.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:phantom_membrane": {
    "base": {
      "loreJson": [
        {
          "text": "A thin, leathery membrane harvested from night-stalking Phantoms, feather-light and vital for mending Elytra wings or brewing slow-falling elixirs.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:potion": {
    "base": {
      "loreJson": [
        {
          "text": "A clear glass flask brimming with shimmering alchemical brew, releasing swirling magical vapors to empower the body when drained.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
