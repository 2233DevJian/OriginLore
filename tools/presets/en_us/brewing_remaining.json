  "minecraft:rabbit_foot": {
    "base": {
      "loreJson": [
        {
          "text": "A soft, dried hare's foot treasured as a charm of good fortune and prized by master brewers to distill elixirs of leaping prowess.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:splash_potion": {
    "base": {
      "loreJson": [
        {
          "text": "A curved alchemical flask charged with fine gunpowder, shattering upon impact to blast its transformative draught over all nearby allies and foes.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  },
  "minecraft:tipped_arrow": {
    "base": {
      "loreJson": [
        {
          "text": "Potion coats the arrowhead, carrying its effect into a successful shot.",
          "color": "gray",
          "italic": true
        }
      ]
    }
  }
